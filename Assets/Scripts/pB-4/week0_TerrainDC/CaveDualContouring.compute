// FIX-1: GetVoxelWorldPos → GetVoxelLocalPos  (_ChunkOffset 제거, 순수 로컬 좌표)
// FIX-2: uint3 언더플로우 → int3 + clamp 으로 안전한 그래디언트 계산
// FIX-3: ClearHermiteBuffer 커널 추가 (청크 간 잔존 데이터 오염 방지)
// FIX-4: edgeCount==0 시 featureType=-1 마킹 (무효 버텍스 → 쿼드 생성 차단)
// FIX-5: 버텍스 노말 = 밀도 그래디언트 부호 반전 (동굴 내부 방향)
// FIX-6: 와인딩 = (d0>0) == (axis==1)  (d>0=암석 관례, 수학적 검증)
// FIX-7: GenerateQuads 버퍼 오버플로우 방지 (appendIdx 범위 체크)
// =============================================================================

#pragma kernel CollectHermiteData
#pragma kernel SolveQEF
#pragma kernel GenerateQuads
#pragma kernel ClearHermiteBuffer   // [FIX-3]
#pragma kernel ClearDCVertexBuffer  // [P0.5-A] GPU Clear
#pragma kernel SplitVoxelBuffer     // [P1-A] CaveVoxel 16B → density 4B + ore 4B
#pragma kernel CompactAndRemap     // [P1-B] 유효 vertex compact + remapTable
#pragma kernel ExtractBoundaryHermiteEdges  // [Phase 3-B] boundary edge 추출 (CPU readback용)
#pragma kernel RemapQuads          // [P1-B] quad 인덱스 리매핑

// [O3] DCHermiteEdge 압축 토글 — 32B→16B
#pragma multi_compile _ COMPRESSED_HERMITE
// [O1] DCVertex 압축 토글 — 56B→32B
#pragma multi_compile _ COMPRESSED_VERTEX

// ============ 구조체 정의 (C# DCDataStructs와 동일) ============

struct CaveVoxel
{
    float density;
    int oreType;
    float2 padding;
};

// [O3] 비압축 구조체 (enableCompressedHermite=OFF 시 사용)
struct DCHermiteEdge
{
    float3 intersectionPoint;
    float3 intersectionNormal;
    int edgeAxis;
    float padding;
};

// ============ [O3] OctWrap 인코딩 (노말 float3 → uint, ~10bit/축) ============
// 주의: HLSL 벡터 ternary 버그 수정 — 축별 개별 비교 (n.x, n.y 독립)
//   미수정 시 n.x>0, n.y<0인 경우 90° 노말 오류 → 파편 직결

float2 _OctWrap(float2 v)
{
    return float2(
        (1.0 - abs(v.y)) * (v.x >= 0.0 ? 1.0 : -1.0),
        (1.0 - abs(v.x)) * (v.y >= 0.0 ? 1.0 : -1.0)
    );
}

uint OctEncode(float3 n)
{
    n /= (abs(n.x) + abs(n.y) + abs(n.z));
    float2 oct = n.xy;
    if (n.z < 0.0) oct = _OctWrap(oct);
    uint2 u = (uint2)(saturate(oct * 0.5 + 0.5) * 65535.0);
    return (u.x & 0xFFFF) | ((u.y & 0xFFFF) << 16);
}

float3 OctDecode(uint packed)
{
    float2 oct;
    oct.x = (float)(packed & 0xFFFF) / 65535.0 * 2.0 - 1.0;
    oct.y = (float)((packed >> 16) & 0xFFFF) / 65535.0 * 2.0 - 1.0;
    float3 n = float3(oct, 1.0 - abs(oct.x) - abs(oct.y));
    if (n.z < 0.0)
    {
        float2 w = _OctWrap(n.xy);
        n.x = w.x; n.y = w.y;
    }
    return normalize(n);
}

// ============ [O3] Half pack 헬퍼 ============

uint PackHalf2(float2 v) { return f32tof16(v.x) | (f32tof16(v.y) << 16); }
float2 UnpackHalf2(uint p) { return float2(f16tof32(p), f16tof32(p >> 16)); }

// ============ [O3] 버퍼 선언 (압축/비압축 분기) ============

#ifdef COMPRESSED_HERMITE
// 압축 16B: uint4(posXY, posZAxis, octNormal, pad)
//   posXY = PackHalf2(relPos.xy)
//   posZAxis = f32tof16(relPos.z) | (axis << 16)  [axis=3 → invalid]
//   octNormal = OctEncode(normal)
RWStructuredBuffer<uint4> _HermiteEdgeBuffer;
#else
RWStructuredBuffer<DCHermiteEdge> _HermiteEdgeBuffer;
#endif

// ============ [O3] Hermite Read/Write 헬퍼 ============

void WriteHermiteEdge(int edgeIdx, float3 iPos, float3 iNrm, int axis, float3 voxelCorner)
{
#ifdef COMPRESSED_HERMITE
    float3 relPos = iPos - voxelCorner;
    uint posXY    = PackHalf2(relPos.xy);
    uint posZAxis = f32tof16(relPos.z) | ((uint)axis << 16);
    uint octN     = OctEncode(iNrm);
    _HermiteEdgeBuffer[edgeIdx] = uint4(posXY, posZAxis, octN, 0);
#else
    DCHermiteEdge edge;
    edge.intersectionPoint  = iPos;
    edge.intersectionNormal = iNrm;
    edge.edgeAxis           = axis;
    edge.padding            = 0;
    _HermiteEdgeBuffer[edgeIdx] = edge;
#endif
}

void ReadHermiteEdge(int edgeIdx, float3 voxelCorner,
                     out float3 iPos, out float3 iNrm, out int axis)
{
#ifdef COMPRESSED_HERMITE
    uint4 packed = _HermiteEdgeBuffer[edgeIdx];
    uint rawAxis = (packed.y >> 16) & 0xFFFF;
    if (rawAxis > 2)
    {
        // Invalid (cleared) edge → zero normal for SolveQEF skip
        iPos = float3(0, 0, 0);
        iNrm = float3(0, 0, 0);
        axis  = 0;
        return;
    }
    float2 relXY = UnpackHalf2(packed.x);
    float  relZ  = f16tof32(packed.y & 0xFFFF);
    axis = (int)rawAxis;
    iPos = float3(relXY, relZ) + voxelCorner;
    iNrm = OctDecode(packed.z);
#else
    DCHermiteEdge edge = _HermiteEdgeBuffer[edgeIdx];
    iPos = edge.intersectionPoint;
    iNrm = edge.intersectionNormal;
    axis  = edge.edgeAxis;
#endif
}

void ClearHermiteEdgeAt(int i)
{
#ifdef COMPRESSED_HERMITE
    // axis=3 → ReadHermiteEdge에서 invalid 판정 → normal=(0,0,0) → SolveQEF skip
    _HermiteEdgeBuffer[i] = uint4(0, (uint)3 << 16, 0, 0);
#else
    DCHermiteEdge cleared;
    cleared.intersectionPoint  = float3(0, 0, 0);
    cleared.intersectionNormal = float3(0, 0, 0);
    cleared.edgeAxis           = 0;
    cleared.padding            = 0;
    _HermiteEdgeBuffer[i] = cleared;
#endif
}

struct DCVertex
{
    float3 position;
    float3 normal;
    float2 uv;
    int featureType;    // -1=무효, 0=Smooth, 1=Edge, 2=Corner  [FIX-4]
    int materialIndex;
    float qefError;
    float3 padding;
};

// [O1] DCVertex 압축 구조체 (32B)
//   position float3 유지 (12B) — AABB/SeamStitcher/FloorSmoothing 정밀도 필수
//   normal → OctWrap uint (4B, ~10bit/축, 오차 <0.002)
//   uv → half2 (4B)
//   featureType 유지 (4B) — FloorSmoothing 가드
//   qefError(half) + materialIndex(ushort) 패킹 (4B)
//   padding (4B) → 32B 정렬
struct DCVertexCompressed
{
    float3 position;    // 12B
    uint   octNormal;   // 4B
    uint   uvPacked;    // 4B (PackHalf2)
    int    featureType; // 4B
    uint   errMat;      // 4B (lower16=half(qefError), upper16=materialIndex)
    uint   padding;     // 4B
};

struct DCQuad
{
    int v0, v1, v2, v3;
};

struct GameplaySculptData
{
    int wantNarrow;
    int wantHighGround;
    int wantDeadEnd;
    float ambushScore;
};

// ============ 버퍼 ============

RWStructuredBuffer<CaveVoxel>       _VoxelBuffer;
// _HermiteEdgeBuffer: 위의 #ifdef COMPRESSED_HERMITE 블록에서 선언됨
#ifdef COMPRESSED_VERTEX
RWStructuredBuffer<DCVertexCompressed> _DCVertexBuffer;
#else
RWStructuredBuffer<DCVertex>           _DCVertexBuffer;
#endif
RWStructuredBuffer<DCQuad>          _DCQuadBuffer;
RWByteAddressBuffer                 _QuadCount;
StructuredBuffer<GameplaySculptData> _GameplaySculptBuffer;

// [P1-A] 압축 버퍼 (enableCompressedVoxel=ON 시 사용)
RWStructuredBuffer<float> _DensityBuffer;   // density만 (4B/voxel)
RWStructuredBuffer<int>   _OreBuffer;       // oreType만 (4B/voxel, LUT)

// [P1-B] Compaction 버퍼
#ifdef COMPRESSED_VERTEX
RWStructuredBuffer<DCVertexCompressed> _CompactVertexBuffer;
#else
RWStructuredBuffer<DCVertex> _CompactVertexBuffer;
#endif
RWStructuredBuffer<int>      _RemapTable;           // flatIdx → compactIdx (-1=무효)
RWByteAddressBuffer          _ValidVertexCount;     // atomic counter

// ============ 유니폼 ============

int   _PointsPerAxis;
float _ChunkSize;       // = (PointsPerAxis - 1) * voxelSize  [FIX-1, FIX-2]
int   _HermiteBufferSize; // ClearHermiteBuffer용

// ============ Phase 2 — DC 품질 토글 ============
int   _EnableVisualSmooth;   // [Phase 2-A] 0=OFF(±2 기존), 1=ON(±3 확장)
int   _EnableMassPointA;     // [Phase 2-C-A] 0=OFF, 1=ON(eigenvalue confidence blend)
int   _EnableMassPointB;     // [Phase 2-C-B] 0=OFF, 1=ON(lambda 0.01→0.1)

// ═════════════════════════════════════════════════════════════
// [Gate 2 / B-α] Boundary Ownership — Mesh Overlap 근본 제거
// ═════════════════════════════════════════════════════════════
// 배경: dcBasePos = chunkBasePos - voxelSize이므로 cell sid[axis]=0 인 cell의
//       axis 방향 edge는 world X = chunkBasePos - 0.5*voxelSize 위치.
//       이는 -axis neighbor chunk 담당 영역임에도 현재 chunk가 quad 생성
//       → mesh overlap 발생 (지그재그 아티팩트 원인)
//
// 동작: _EnableBoundaryOwnership=1 시 sid[axis]=0 cell의 axis edge quad 생성 skip
//       → 자기 담당 영역 edge만 생성 → 인접 chunk와 mesh 중복 제거
//
// 규칙 #6: OFF(=0) 시 기존 동작 완전 유지 (bit-identical)
// 규칙 #3: GenerateQuads kernel 내부 분기만 — 다른 kernel 미영향
// ═════════════════════════════════════════════════════════════
int   _EnableBoundaryOwnership;   // 0=OFF(overlap 유지), 1=ON(내 담당 edge만)

// ═════════════════════════════════════════════════════════════
// [Phase 2 — Mass Point QEF (Schaefer/Warren 2005)] 
//   수학: min ||Ax - b||² + λ_mp ||x - c_m||²
//          → (AᵀA + (λ_reg + λ_mp)·I) x = Aᵀb + λ_mp·c_m
//
//   기존 MassPointA/B와의 차이 (규칙 #19 명시):
//     MassPointA: QEF 해를 구한 후 massPoint와 lerp (사후 blend)
//     MassPointB: λ_reg 값만 증가 (Tikhonov 정규화 강화, mass point 무관)
//     Phase 2  : normal equation 자체에 λ_mp·c_m 추가 — 수학적 정통
//
//   효과 (fragC_strategic_evaluation.html §4 T3-3):
//     - 양쪽 chunk가 같은 edge intersection → 같은 massPoint 중심으로 수렴
//     - ATA rank-deficient 시 vertex가 voxel 바깥으로 날아가지 않고 massPoint로 bias
//     - FragC-γ (float 오차) + FragB 원인 1 잔존 + FragA 일부 완화
//
//   규칙 #6: _EnablePhase2MassPointQEF=0 시 기존 SolveQEF_Cholesky 경로 bit-identical.
//   규칙 #3: GenerateQuads 미수정 (SolveQEF 커널 내부만 확장).
//   규칙 #19: intersection point (p) + normal (n) + massPoint (c_m) 만 사용.
//             합성 bulk SDF 지표 미사용.
// ═════════════════════════════════════════════════════════════
int   _EnablePhase2MassPointQEF;    // 0=OFF(원본), 1=ON(Mass Point bias 통합)
float _Phase2MassPointStrength;     // λ_mp — mass point bias 강도 (권장 0.1~1.0)

// ═════════════════════════════════════════════════════════════
// [Phase 3-B — DC Overlap Removal / Ghost QEF]
//
// 목적:
//   DCPointsPerAxis=ChunkSize+1 상태에서 boundary cell의 QEF 계산 시
//   인접 chunk의 boundary edge 정보를 함께 사용해 seam vertex를 bit-identical 일치.
//
// 데이터 구조:
//   GhostEdge = { intersectionPoint(3f), normal(3f), cellIndexLinear(int), edgeAxis(int) } = 32B
//   _GhostEdgeBuffer: 모든 6면의 edge를 단일 버퍼에 직렬화
//   _GhostFaceOffsets (int4 × 2): face별 버퍼 내 시작 offset
//                                  x/y/z/w = +X/-X/+Y/-Y face 시작 index
//                                  _GhostFaceOffsetsZ.xy = +Z/-Z 시작 index (별도 uniform)
//   _GhostFaceCounts (int4 × 2): face별 edge 개수
//                                  x/y/z/w = +X/-X/+Y/-Y
//                                  _GhostFaceCountsZ.xy = +Z/-Z
//
// 규칙 #3: GenerateQuads 커널 미수정. SolveQEF 내부 boundary 분기만.
// 규칙 #6: _EnablePhase3GhostQEF=0 시 ghost 버퍼 참조 안 함 → bit-identical.
// 규칙 #19: ghost edges의 출처 — 인접 chunk의 Hermite buffer에서 CPU 측 추출 후 주입.
// 규칙 #22: ghost가 ATA/ATb/massPoint에 누적됨 → 이후 Mass Point QEF + AABB clamp +
//          Edge snap + Ridge relaxation chain을 정상 통과.
//          → 양쪽 chunk가 같은 ghost input → 같은 chain 결과 → seam 일치.
// ═════════════════════════════════════════════════════════════
struct GhostEdge
{
    float3 intersectionPoint;   // chunk local 좌표
    float3 normal;              // unit
    int    cellIndexLinear;     // 경계면 내 1D 인덱스 (face 평면상 i*N+j)
    int    edgeAxis;            // 0=X, 1=Y, 2=Z
};

int _EnablePhase3GhostQEF;               // 0=OFF(원본), 1=ON(boundary에 ghost edges 통합)
StructuredBuffer<GhostEdge> _GhostEdgeBuffer;
int4 _GhostFaceOffsets;                  // +X/-X/+Y/-Y face 시작 index
int2 _GhostFaceOffsetsZ;                 // +Z/-Z face 시작 index
int4 _GhostFaceCounts;                   // +X/-X/+Y/-Y face edge 개수
int2 _GhostFaceCountsZ;                  // +Z/-Z face edge 개수

// [P1-A] 압축 토글
int   _UseCompressedVoxel;   // 0=OFF(원본 _VoxelBuffer), 1=ON(압축 _DensityBuffer+_OreBuffer)

// ============ [P1-A] 밀도/광석 읽기 헬퍼 ============
// OFF: ReadDensity(idx) (원본 16B 접근, 비트 동일)
// ON:  _DensityBuffer[idx] (압축 4B 접근, 캐시 4× 효율)
float ReadDensity(int idx)
{
    return (_UseCompressedVoxel == 1) ? _DensityBuffer[idx] : _VoxelBuffer[idx].density;
}
int ReadOreType(int idx)
{
    return (_UseCompressedVoxel == 1) ? _OreBuffer[idx] : _VoxelBuffer[idx].oreType;
}

// ============ [O1] DCVertex Write/Read 헬퍼 ============
// 버퍼 선언 후 위치 — _DCVertexBuffer 접근 가능

void WriteDCVertex(int idx, float3 pos, float3 nrm, float2 uv,
                   int ft, int matIdx, float qefErr)
{
#ifdef COMPRESSED_VERTEX
    DCVertexCompressed cv;
    cv.position   = pos;
    cv.octNormal  = OctEncode(nrm);
    cv.uvPacked   = PackHalf2(uv);
    cv.featureType = ft;
    cv.errMat     = (f32tof16(qefErr) & 0xFFFF) | (((uint)matIdx & 0xFFFF) << 16);
    cv.padding    = 0;
    _DCVertexBuffer[idx] = cv;
#else
    DCVertex v;
    v.position      = pos;
    v.normal        = nrm;
    v.uv            = uv;
    v.featureType   = ft;
    v.materialIndex = matIdx;
    v.qefError      = qefErr;
    v.padding       = float3(0, 0, 0);
    _DCVertexBuffer[idx] = v;
#endif
}

void ReadDCVertex(int idx, out float3 pos, out float3 nrm, out float2 uv,
                  out int ft, out int matIdx, out float qefErr)
{
#ifdef COMPRESSED_VERTEX
    DCVertexCompressed cv = _DCVertexBuffer[idx];
    pos    = cv.position;
    nrm    = OctDecode(cv.octNormal);
    uv     = UnpackHalf2(cv.uvPacked);
    ft     = cv.featureType;
    qefErr = f16tof32(cv.errMat & 0xFFFF);
    matIdx = (int)((cv.errMat >> 16) & 0xFFFF);
#else
    DCVertex v = _DCVertexBuffer[idx];
    pos    = v.position;
    nrm    = v.normal;
    uv     = v.uv;
    ft     = v.featureType;
    matIdx = v.materialIndex;
    qefErr = v.qefError;
#endif
}

// ============ 헬퍼 함수 ============

// [FIX-1] GetVoxelWorldPos → GetVoxelLocalPos
//   기존: _ChunkOffset(청크 정수 단위) + id*spacing → 잘못된 월드 좌표
//   수정: _ChunkOffset 제거, id*spacing만 반환 → 순수 로컬 좌표 [0, ChunkSize]
//   월드 배치는 CaveChunkManager가 chunkObj.transform.position으로 담당.
float3 GetVoxelLocalPos(uint3 id)
{
    float spacing = _ChunkSize / (float)(_PointsPerAxis - 1);
    return float3(id) * spacing;
}

// int3 오버로드 — clamp 결과에 사용
float3 GetVoxelLocalPosI(int3 id)
{
    float spacing = _ChunkSize / (float)(_PointsPerAxis - 1);
    return float3(id) * spacing;
}

int FlatIndex(int3 id)
{
    return id.x + id.y * _PointsPerAxis + id.z * _PointsPerAxis * _PointsPerAxis;
}

// ============ QEF 수학 함수 ============

float3 SolveQEF_Cholesky(float3x3 ATA, float3 ATb, float regLambda)
{
    ATA[0][0] += regLambda;
    ATA[1][1] += regLambda;
    ATA[2][2] += regLambda;

    float l00 = sqrt(max(ATA[0][0], 1e-10));
    float l10 = ATA[1][0] / l00;
    float l11 = sqrt(max(ATA[1][1] - l10 * l10, 1e-10));
    float l20 = ATA[2][0] / l00;
    float l21 = (ATA[2][1] - l20 * l10) / l11;
    float l22 = sqrt(max(ATA[2][2] - l20 * l20 - l21 * l21, 1e-10));

    float y0 = ATb.x / l00;
    float y1 = (ATb.y - l10 * y0) / l11;
    float y2 = (ATb.z - l20 * y0 - l21 * y1) / l22;

    float x2 = y2 / l22;
    float x1 = (y1 - l21 * x2) / l11;
    float x0 = (y0 - l10 * x1 - l20 * x2) / l00;

    return float3(x0, x1, x2);
}


// ═════════════════════════════════════════════════════════════
// [Phase 2] Mass Point QEF — Schaefer/Warren 2005 정통 공식
//
// 수학 유도:
//   원래 QEF 최소화: E(x) = Σᵢ (nᵢ·(x - pᵢ))² = ||Ax - b||²
//     A: edge normal 행렬 (k×3), b: dot(nᵢ, pᵢ) 벡터
//     정규방정식: AᵀA·x = Aᵀb
//
//   Mass Point 보강: E'(x) = E(x) + λ_mp·||x - c_m||²
//     c_m = (1/k) Σᵢ pᵢ (intersection centroid)
//     미분: 2·AᵀA·x - 2·Aᵀb + 2·λ_mp·(x - c_m) = 0
//     정규방정식: (AᵀA + λ_mp·I)·x = Aᵀb + λ_mp·c_m
//
//   λ_reg(Tikhonov) + λ_mp(MassPoint) 합산 정규화:
//     최종: (AᵀA + (λ_reg + λ_mp)·I)·x = Aᵀb + λ_mp·c_m
//
//   λ_mp = 0 이면 기존 SolveQEF_Cholesky와 수학적으로 동일.
//   λ_mp → ∞ 이면 x = c_m (massPoint 해).
//
// 기존 SolveQEF_Cholesky와의 관계:
//   λ_mp=0 + massPoint=(0,0,0) 전달 시 기존 함수와 bit-identical.
//   But _EnablePhase2MassPointQEF=0 시 이 함수를 호출하지 않으므로
//   기존 경로는 완전히 변하지 않음 (규칙 #6).
// ═════════════════════════════════════════════════════════════
float3 SolveQEF_Cholesky_MassPoint(
    float3x3 ATA, float3 ATb, float regLambda,
    float3 massPoint, float massPointLambda)
{
    // λ_reg (Tikhonov) + λ_mp (Mass Point) 합산 정규화
    float totalLambda = regLambda + massPointLambda;
    ATA[0][0] += totalLambda;
    ATA[1][1] += totalLambda;
    ATA[2][2] += totalLambda;

    // RHS에 λ_mp·c_m 추가 (Mass Point bias)
    ATb += massPointLambda * massPoint;

    // Cholesky 분해 + 해 복원 (SolveQEF_Cholesky와 동일 수치 로직)
    float l00 = sqrt(max(ATA[0][0], 1e-10));
    float l10 = ATA[1][0] / l00;
    float l11 = sqrt(max(ATA[1][1] - l10 * l10, 1e-10));
    float l20 = ATA[2][0] / l00;
    float l21 = (ATA[2][1] - l20 * l10) / l11;
    float l22 = sqrt(max(ATA[2][2] - l20 * l20 - l21 * l21, 1e-10));

    float y0 = ATb.x / l00;
    float y1 = (ATb.y - l10 * y0) / l11;
    float y2 = (ATb.z - l20 * y0 - l21 * y1) / l22;

    float x2 = y2 / l22;
    float x1 = (y1 - l21 * x2) / l11;
    float x0 = (y0 - l10 * x1 - l20 * x2) / l00;

    return float3(x0, x1, x2);
}


// ════════════════════════════════════════════════════════════════════
// [Phase 3-B] Ghost Edge 누적 헬퍼
//   boundary cell의 QEF 계산에 인접 chunk의 edge intersection/normal을 포함.
//
// 동작:
//   1. sid (current cell)가 어느 face의 경계 cell인지 판정
//   2. 해당 face의 ghost edges를 순회
//   3. 각 ghost edge의 cellIndexLinear가 이 cell의 face-local index와 일치하면
//      intersection + normal을 ATA/ATb/massPoint에 누적
//
// Face → Cell index mapping:
//   +X face: cellIndex = sid.y * N + sid.z  (YZ 평면)
//   -X face: 동일 (YZ 평면)
//   +Y face: cellIndex = sid.x * N + sid.z  (XZ 평면)
//   -Y face: 동일
//   +Z face: cellIndex = sid.x * N + sid.y  (XY 평면)
//   -Z face: 동일
//
// 성능:
//   각 boundary cell은 최대 1개 face에 속함 (corner cell은 복수).
//   edge 순회는 해당 face의 edges만 (전체 ghost 버퍼가 아니라 offset~offset+count)
//   실제 부담: boundary cell 당 평균 10~30 edges 순회 + ATA 누적
//   전체 비용: 경계면 cells × 평균 edges = 11,449 × 25 = ~286k 연산 / chunk (수용 가능)
// ════════════════════════════════════════════════════════════════════
void AccumulateGhostEdges(
    int3 sid,
    inout float3x3 ATA,
    inout float3 ATb,
    inout float3 massPoint,
    inout int edgeCount)
{
    int N = _PointsPerAxis;

    // Face 경계 판정: 각 축의 최소/최대 cell
    // DCPointsPerAxis=ChunkSize+1 시 유효 cell range [0, N-2]
    // boundary cell은 sid.axis==0 (음의 face) 또는 sid.axis==N-2 (양의 face)
    bool onPosX = (sid.x == N - 2);
    bool onNegX = (sid.x == 0);
    bool onPosY = (sid.y == N - 2);
    bool onNegY = (sid.y == 0);
    bool onPosZ = (sid.z == N - 2);
    bool onNegZ = (sid.z == 0);

    // 여섯 faces에 대해 관련 edges를 순회
    // face index: 0=+X, 1=-X, 2=+Y, 3=-Y, 4=+Z, 5=-Z
    int faceOffsets[6] = {
        _GhostFaceOffsets.x, _GhostFaceOffsets.y,
        _GhostFaceOffsets.z, _GhostFaceOffsets.w,
        _GhostFaceOffsetsZ.x, _GhostFaceOffsetsZ.y
    };
    int faceCounts[6] = {
        _GhostFaceCounts.x, _GhostFaceCounts.y,
        _GhostFaceCounts.z, _GhostFaceCounts.w,
        _GhostFaceCountsZ.x, _GhostFaceCountsZ.y
    };
    bool faceActive[6] = { onPosX, onNegX, onPosY, onNegY, onPosZ, onNegZ };

    // 각 face의 cell index (해당 평면에서 이 cell의 1D index)
    // face 평면에 직교하지 않는 두 축의 (i, j) → i*N + j
    int faceCellIdx[6];
    faceCellIdx[0] = sid.y * N + sid.z;   // +X
    faceCellIdx[1] = sid.y * N + sid.z;   // -X (같은 YZ 평면)
    faceCellIdx[2] = sid.x * N + sid.z;   // +Y
    faceCellIdx[3] = sid.x * N + sid.z;   // -Y
    faceCellIdx[4] = sid.x * N + sid.y;   // +Z
    faceCellIdx[5] = sid.x * N + sid.y;   // -Z

    [unroll]
    for (int f = 0; f < 6; f++)
    {
        if (!faceActive[f]) continue;
        int offset = faceOffsets[f];
        int cnt = faceCounts[f];
        int targetCellIdx = faceCellIdx[f];

        // 해당 face의 edge 리스트 순회
        // (CPU 측에서 이미 cellIndexLinear로 정렬하면 binary search 가능 but 현재는 linear)
        for (int i = 0; i < cnt; i++)
        {
            GhostEdge ge = _GhostEdgeBuffer[offset + i];
            if (ge.cellIndexLinear != targetCellIdx) continue;

            float3 p = ge.intersectionPoint;
            float3 n = ge.normal;

            if (length(n) < 0.01) continue;

            ATA[0][0] += n.x * n.x; ATA[0][1] += n.x * n.y; ATA[0][2] += n.x * n.z;
            ATA[1][0] += n.y * n.x; ATA[1][1] += n.y * n.y; ATA[1][2] += n.y * n.z;
            ATA[2][0] += n.z * n.x; ATA[2][1] += n.z * n.y; ATA[2][2] += n.z * n.z;

            float d = dot(n, p);
            ATb += n * d;

            massPoint += p;
            edgeCount++;
        }
    }
}


// ====================================================================
// [Phase 3] Jacobi 3x3 대칭 행렬 고유값 분해
//   반복 10회 (GPU 상수 반복, 분기 없음)
//   출력: eigenvalues, eigenvectors (열 벡터)
// ====================================================================
void JacobiEigen3x3(float3x3 A, out float3 eigenvals, out float3x3 eigenvecs)
{
    float3x3 V = float3x3(1,0,0, 0,1,0, 0,0,1);
    float3x3 D = A;
    [unroll(10)]
    for (int iter = 0; iter < 10; iter++)
    {
        int3 pqs[3] = { int3(0,1,0), int3(0,2,0), int3(1,2,0) };
        for (int k = 0; k < 3; k++)
        {
            int p = pqs[k].x, q = pqs[k].y;
            float apq = D[p][q];
            if (abs(apq) < 1e-8) continue;
            float app = D[p][p], aqq = D[q][q];
            float theta = 0.5 * atan2(2.0 * apq, app - aqq);
            float c = cos(theta), s = sin(theta);
            float3x3 Rot = float3x3(1,0,0, 0,1,0, 0,0,1);
            Rot[p][p] =  c; Rot[p][q] = -s;
            Rot[q][p] =  s; Rot[q][q] =  c;
            D = mul(transpose(Rot), mul(D, Rot));
            V = mul(V, Rot);
        }
    }
    eigenvals = float3(D[0][0], D[1][1], D[2][2]);
    eigenvecs = V;
}

float3 ComputeRidgeDir(float3x3 ATA)
{
    float3 ev; float3x3 evec;
    JacobiEigen3x3(ATA, ev, evec);
    // 가장 큰 두 고유값의 고유벡터로 능선 방향 계산
    int i0=0, i1=1, i2=2;
    if (ev[i0] < ev[i1]) { int t=i0; i0=i1; i1=t; }
    if (ev[i0] < ev[i2]) { int t=i0; i0=i2; i2=t; }
    if (ev[i1] < ev[i2]) { int t=i1; i1=i2; i2=t; }
    float3 v0 = float3(evec[0][i0], evec[1][i0], evec[2][i0]);
    float3 v1 = float3(evec[0][i1], evec[1][i1], evec[2][i1]);
    float3 rDir = cross(v0, v1);
    float rLen = length(rDir);
    return rLen < 0.001 ? float3(0,1,0) : rDir / rLen;
}


// ====================================================================
// [S2] QEF 위치 Trilinear SDF 그라디언트 재샘플
//   qefSolution(실제 표면 위치)에서 SDF를 trilinear 보간으로 샘플
//   sid 기준 차분보다 실제 표면 법선 방향에 훨씬 가까운 노말을 생성
//   sampleStep 경계 처리: pos_v를 [0.5, N-1.5]로 클램프하여 경계 오류 방지
// ====================================================================
float SampleSDF_Safe(float3 pos_local, float spacing)
{
    float3 pos_v = pos_local / spacing;
    // 경계 마진: 반 셀 크기로 제한 → 경계 복셀 중복 샘플 방지
    int N = _PointsPerAxis;
    pos_v = clamp(pos_v, float3(0.5, 0.5, 0.5),
                         float3(N - 1.5, N - 1.5, N - 1.5));
    int3 c = (int3)floor(pos_v);
    float3 f = frac(pos_v);
    // 8코너 trilinear 보간
    float d000 = ReadDensity(FlatIndex(c                  ));
    float d100 = ReadDensity(FlatIndex(c + int3(1, 0, 0)));
    float d010 = ReadDensity(FlatIndex(c + int3(0, 1, 0)));
    float d110 = ReadDensity(FlatIndex(c + int3(1, 1, 0)));
    float d001 = ReadDensity(FlatIndex(c + int3(0, 0, 1)));
    float d101 = ReadDensity(FlatIndex(c + int3(1, 0, 1)));
    float d011 = ReadDensity(FlatIndex(c + int3(0, 1, 1)));
    float d111 = ReadDensity(FlatIndex(c + int3(1, 1, 1)));
    float dx00 = lerp(d000, d100, f.x);
    float dx10 = lerp(d010, d110, f.x);
    float dx01 = lerp(d001, d101, f.x);
    float dx11 = lerp(d011, d111, f.x);
    float dxy0 = lerp(dx00, dx10, f.y);
    float dxy1 = lerp(dx01, dx11, f.y);
    return lerp(dxy0, dxy1, f.z);
}

int ClassifyFeature(float3x3 ATA)
{
    float trace = ATA[0][0] + ATA[1][1] + ATA[2][2];
    float avg = trace / 3.0;
    float totalVar = abs(ATA[0][0] - avg) + abs(ATA[1][1] - avg) + abs(ATA[2][2] - avg);

    // [Phase 2] 상대 임계값 조정: 절대값(0.01/0.1) → 곡률 스케일 의존성 완화
    // 0.05: 완만한 곡면이 Edge로 오분류되는 현상 감소
    // 0.20: Corner 판정 범위 확대 (강한 모서리 보존)
    // [수정] smooth 임계값 0.05→0.08: 등방성 셀이 Edge로 오분류되는 것 방지
    // Edge→Corner 임계값 0.20→0.25: 더 강한 특징만 Corner 판정
    if (totalVar < 0.08) return 0;
    else if (totalVar < 0.25) return 1;
    else return 2;
}

// ====================================================================
// [FIX-3] Kernel 0: ClearHermiteBuffer
//   청크 디스패치 전 반드시 호출.
//   intersectionNormal = (0,0,0) → SolveQEF의 length < 0.01 가드에서 자동 스킵.
// ====================================================================
[numthreads(256, 1, 1)]
void ClearHermiteBuffer(uint3 id : SV_DispatchThreadID)
{
    int i = (int)id.x;
    if (i >= _HermiteBufferSize) return;
    ClearHermiteEdgeAt(i);  // [O3] 압축/비압축 분기 헬퍼
}

// ====================================================================
// [P0.5-A] Kernel: ClearDCVertexBuffer  (enableGpuClear=ON 시 사용)
//   CPU SetData(71MB) 18ms → GPU Dispatch 0.5ms
//   모든 필드를 C# struct default와 비트 동일하게 초기화
//   featureType=-1 → GenerateQuads에서 무효 vertex 스킵
// ====================================================================
int _DCVertexBufferSize;

[numthreads(256, 1, 1)]
void ClearDCVertexBuffer(uint3 id : SV_DispatchThreadID)
{
    int i = (int)id.x;
    if (i >= _DCVertexBufferSize) return;
    // [O1] WriteDCVertex — 압축/비압축 분기 헬퍼 (featureType=-1 → 무효 마커)
    WriteDCVertex(i, float3(0,0,0), float3(0,0,0), float2(0,0), -1, 0, 0.0);
}

// ====================================================================
// [P1-A] Kernel: SplitVoxelBuffer
//   CaveVoxel(16B) → _DensityBuffer(4B) + _OreBuffer(4B) 분리
//   enableCompressedVoxel=ON 시 DispatchDC 직전에 1회 실행
// ====================================================================
int _SplitBufferSize;  // N³

[numthreads(256, 1, 1)]
void SplitVoxelBuffer(uint3 id : SV_DispatchThreadID)
{
    int i = (int)id.x;
    if (i >= _SplitBufferSize) return;
    _DensityBuffer[i] = _VoxelBuffer[i].density;
    _OreBuffer[i]     = _VoxelBuffer[i].oreType;
}

// ====================================================================
// Kernel 1: CollectHermiteData
// ====================================================================
[numthreads(8, 8, 8)]
void CollectHermiteData(uint3 id : SV_DispatchThreadID)
{
    int N = _PointsPerAxis;
    if ((int)id.x >= N - 1 || (int)id.y >= N - 1 || (int)id.z >= N - 1)
        return;

    int3 sid = (int3)id;
    int  idx = FlatIndex(sid);
    float d0 = ReadDensity(idx);

    int3 axisNeighbors[3];
    axisNeighbors[0] = int3(1, 0, 0);
    axisNeighbors[1] = int3(0, 1, 0);
    axisNeighbors[2] = int3(0, 0, 1);

    for (int axis = 0; axis < 3; axis++)
    {
        int3 nid = sid + axisNeighbors[axis];
        if (nid.x >= N || nid.y >= N || nid.z >= N)
            continue;

        float d1 = ReadDensity(FlatIndex(nid));

        if ((d0 > 0.0) == (d1 > 0.0))
            continue;
        // [Fix-Phantom v2] 허위 교차 필터 — 임계값 0.008 (voxelSize*0.5m의 1.6%)
        // 0.05는 과도하게 넓어 완만한 곡면 교차를 제거 → 구멍(hole) 발생
        // 0.008: 수치 노이즈 ε 수준만 제거, 실제 표면 교차는 보존
        if ((abs(d0) + abs(d1)) < 0.008)
            continue;

        // 선형 보간 교차점
        float t = d0 / (d0 - d1);
        float3 p0 = GetVoxelLocalPos((uint3)sid);
        float3 p1 = GetVoxelLocalPos((uint3)nid);
        float3 intersection = lerp(p0, p1, t);

        // [FIX-2] uint3 언더플로우 → int3 + clamp
        //   기존: max(id - uint3(1,0,0), 0) → uint 언더플로우 발생
        //   수정: int3 산술 후 clamp([0, N-1])
        // [개선-G] ±2 가중 차분 → 고주파 SDF 노이즈 노말 안정화
        int3 px1 = clamp(sid + int3(1,0,0), int3(0,0,0), int3(N-1,N-1,N-1));
        int3 px0 = clamp(sid - int3(1,0,0), int3(0,0,0), int3(N-1,N-1,N-1));
        int3 py1 = clamp(sid + int3(0,1,0), int3(0,0,0), int3(N-1,N-1,N-1));
        int3 py0 = clamp(sid - int3(0,1,0), int3(0,0,0), int3(N-1,N-1,N-1));
        int3 pz1 = clamp(sid + int3(0,0,1), int3(0,0,0), int3(N-1,N-1,N-1));
        int3 pz0 = clamp(sid - int3(0,0,1), int3(0,0,0), int3(N-1,N-1,N-1));
        int3 px2 = clamp(sid + int3(2,0,0), int3(0,0,0), int3(N-1,N-1,N-1));
        int3 pxm2= clamp(sid - int3(2,0,0), int3(0,0,0), int3(N-1,N-1,N-1));
        int3 py2 = clamp(sid + int3(0,2,0), int3(0,0,0), int3(N-1,N-1,N-1));
        int3 pym2= clamp(sid - int3(0,2,0), int3(0,0,0), int3(N-1,N-1,N-1));
        int3 pz2 = clamp(sid + int3(0,0,2), int3(0,0,0), int3(N-1,N-1,N-1));
        int3 pzm2= clamp(sid - int3(0,0,2), int3(0,0,0), int3(N-1,N-1,N-1));
        float3 grad = float3(
            (ReadDensity(FlatIndex(px1)) - ReadDensity(FlatIndex(px0)))*0.8
            + (ReadDensity(FlatIndex(px2)) - ReadDensity(FlatIndex(pxm2)))*0.2,
            (ReadDensity(FlatIndex(py1)) - ReadDensity(FlatIndex(py0)))*0.8
            + (ReadDensity(FlatIndex(py2)) - ReadDensity(FlatIndex(pym2)))*0.2,
            (ReadDensity(FlatIndex(pz1)) - ReadDensity(FlatIndex(pz0)))*0.8
            + (ReadDensity(FlatIndex(pz2)) - ReadDensity(FlatIndex(pzm2)))*0.2
        );

        // [Phase 2-A] VisualSmooth: ±3 확장 gradient 혼합
        // OFF: 기존 ±1/±2 가중 차분만 사용
        // ON:  ±3 추가 → 전이대 gradient 안정화 → normalFlip 감소
        if (_EnableVisualSmooth == 1)
        {
            int3 px3  = clamp(sid + int3(3,0,0), int3(0,0,0), int3(N-1,N-1,N-1));
            int3 pxm3 = clamp(sid - int3(3,0,0), int3(0,0,0), int3(N-1,N-1,N-1));
            int3 py3  = clamp(sid + int3(0,3,0), int3(0,0,0), int3(N-1,N-1,N-1));
            int3 pym3 = clamp(sid - int3(0,3,0), int3(0,0,0), int3(N-1,N-1,N-1));
            int3 pz3  = clamp(sid + int3(0,0,3), int3(0,0,0), int3(N-1,N-1,N-1));
            int3 pzm3 = clamp(sid - int3(0,0,3), int3(0,0,0), int3(N-1,N-1,N-1));
            float3 grad3 = float3(
                ReadDensity(FlatIndex(px3))  - ReadDensity(FlatIndex(pxm3)),
                ReadDensity(FlatIndex(py3))  - ReadDensity(FlatIndex(pym3)),
                ReadDensity(FlatIndex(pz3))  - ReadDensity(FlatIndex(pzm3))
            );
            // 가중치: ±1=0.6, ±2=0.15, ±3=0.1 (합산 ≈ 원래 크기 유지)
            grad = grad * 0.882 + grad3 * 0.118;
        }

        float gLen = length(grad);
        float3 normal = gLen > 1e-6 ? -grad / gLen : float3(0, 1, 0);

        int edgeIdx = FlatIndex(sid) * 3 + axis;
        // [O3] WriteHermiteEdge — 압축 시 relPos+OctWrap, 비압축 시 원본 구조체
        float3 voxelCorner = GetVoxelLocalPos((uint3)sid);
        WriteHermiteEdge(edgeIdx, intersection, normal, axis, voxelCorner);
    }
}

// ====================================================================
// Kernel 2: SolveQEF
// ====================================================================
[numthreads(8, 8, 8)]
void SolveQEF(uint3 id : SV_DispatchThreadID)
{
    int N = _PointsPerAxis;
    if ((int)id.x >= N - 1 || (int)id.y >= N - 1 || (int)id.z >= N - 1)
        return;

    int3 sid = (int3)id;
    int  idx = FlatIndex(sid);

    // [Gate 2 / B-α 보강 — padding cell 전면 skip]
    //   sid.x/y/z == 0 인 cell은 dcBasePos = chunkBasePos - voxelSize 구조상
    //   청크 공간 *밖* (인접 chunk 담당 영역). 기존 L1080 axisIdx==0 continue는
    //   동일 axis 방향 edge quad만 차단 → 다른 축 quad가 여전히 padding vertex를
    //   참조하여 mesh가 chunk 경계 밖으로 삐져나가는 현상 발생.
    //   여기서 featureType=-1로 마크하면 어떤 quad에서도 사용 안 됨.
    //   규칙 #6: _EnableBoundaryOwnership=0 시 기존 로직 유지 (bit-identical).
    //   Ghost Density는 영향 없음 (density sampling은 별도 경로).
    //   Vertex Mirror: self padding vertex는 애초에 mesh에 없으므로 불필요.
    if (_EnableBoundaryOwnership != 0 && (sid.x == 0 || sid.y == 0 || sid.z == 0))
    {
        WriteDCVertex(idx, float3(0,0,0), float3(0,1,0), float2(0,0), -1, 0, -1.0);
        return;
    }

    float3x3 ATA = (float3x3)0;
    float3 ATb = float3(0, 0, 0);
    float3 massPoint = float3(0, 0, 0);
    int edgeCount = 0;

    for (int dx = 0; dx <= 1; dx++)
    for (int dy = 0; dy <= 1; dy++)
    for (int dz = 0; dz <= 1; dz++)
    {
        int3 nid = sid + int3(dx, dy, dz);
        if (nid.x >= N - 1 || nid.y >= N - 1 || nid.z >= N - 1)
            continue;

        int nIdx = FlatIndex(nid);
        for (int axis = 0; axis < 3; axis++)
        {
            int edgeIdx = nIdx * 3 + axis;
            // [O3] ReadHermiteEdge — 압축 시 relPos+OctDecode, 비압축 시 원본 구조체
            float3 voxelCorner = GetVoxelLocalPos((uint3)nid);
            float3 p, n; int edgeAxis;
            ReadHermiteEdge(edgeIdx, voxelCorner, p, n, edgeAxis);

            if (length(n) < 0.01)
                continue;

            ATA[0][0] += n.x * n.x; ATA[0][1] += n.x * n.y; ATA[0][2] += n.x * n.z;
            ATA[1][0] += n.y * n.x; ATA[1][1] += n.y * n.y; ATA[1][2] += n.y * n.z;
            ATA[2][0] += n.z * n.x; ATA[2][1] += n.z * n.y; ATA[2][2] += n.z * n.z;

            float d = dot(n, p);
            ATb += n * d;

            massPoint += p;
            edgeCount++;
        }
    }

    // [Phase 3-B] Ghost Edge 누적 — boundary cell인 경우 인접 chunk의 edges 포함
    //   규칙 #6: _EnablePhase3GhostQEF=0 시 호출 안 됨 → ATA/ATb/massPoint/edgeCount 변화 없음
    //            → 기존 경로와 bit-identical
    //   규칙 #22: 이 누적 이후 기존 post-processing chain (AABB clamp + Edge snap + 
    //            Ridge relaxation)이 정상 진행 → 양쪽 chunk가 같은 ghost input → 같은 출력
    //   규칙 #19: ghost edges는 원시 intersectionPoint + normal (합성 지표 미사용)
    if (_EnablePhase3GhostQEF == 1)
    {
        AccumulateGhostEdges(sid, ATA, ATb, massPoint, edgeCount);
    }

    // [FIX-4] edgeCount==0 → featureType=-1 마킹 (GenerateQuads에서 쿼드 차단)
    //   기존: return; → dcVertexBuffer[idx] = 버퍼 기본값(0) → featureType=0(유효로 오해)
    if (edgeCount == 0)
    {
        WriteDCVertex(idx, float3(0,0,0), float3(0,1,0), float2(0,0), -1, 0, -1.0);
        return;
    }

    massPoint /= (float)edgeCount;

    // [Phase 2-C-B] MassPointB: Tikhonov 정규화 강화 (lambda 0.01→0.1)
    // OFF: 기존 lambda=0.01 (sharp feature 보존, 파편 위험)
    // ON:  lambda=0.1 (vertex가 voxel 중심으로 수렴, 파편 감소)
    float regLambda = (_EnableMassPointB == 1) ? 0.1 : 0.01;

    // [Phase 2] Mass Point QEF 분기 (Schaefer/Warren 2005)
    //   OFF(_EnablePhase2MassPointQEF=0): 기존 SolveQEF_Cholesky 호출 — bit-identical (규칙 #6)
    //   ON : 정규방정식에 λ_mp·c_m bias 통합 — FragC-γ + FragB 원인 1 잔존 완화
    float3 qefSolution;
    if (_EnablePhase2MassPointQEF == 1)
    {
        qefSolution = SolveQEF_Cholesky_MassPoint(
            ATA, ATb, regLambda, massPoint, _Phase2MassPointStrength);
    }
    else
    {
        qefSolution = SolveQEF_Cholesky(ATA, ATb, regLambda);
    }

    // [Phase 2-C-A] MassPointA: eigenvalue confidence blend (Schaefer 2003)
    // OFF: QEF 해 그대로 사용
    // ON:  ATA 조건수 기반 — 불안정할수록 massPoint, 안정적이면 QEF
    if (_EnableMassPointA == 1)
    {
        float3 ev; float3x3 evec;
        JacobiEigen3x3(ATA, ev, evec);
        // eigenvalue 절대값으로 정렬
        float evMin = min(abs(ev.x), min(abs(ev.y), abs(ev.z)));
        float evMax = max(abs(ev.x), max(abs(ev.y), abs(ev.z)));
        // confidence = min/max (0=완전 불안정, 1=완전 안정)
        float confidence = (evMax > 1e-6) ? saturate(evMin / evMax) : 0.0;
        // threshold 완화: spacing² × 0.5 기준 — 작은 edgeCount에서 과도한 fallback 방지
        float spacing_sq = (_ChunkSize / (float)(_PointsPerAxis - 1));
        spacing_sq *= spacing_sq;
        // edgeCount < 3이면 데이터 부족 → confidence 강제 0 (massPoint fallback)
        if (edgeCount < 3) confidence = 0.0;
        qefSolution = lerp(massPoint, qefSolution, confidence);
    }

    // 복셀 AABB 내 클램핑
    float spacing = _ChunkSize / (float)(_PointsPerAxis - 1);
    float3 voxelMin = GetVoxelLocalPos((uint3)sid);
    float3 voxelMax = voxelMin + float3(spacing, spacing, spacing);
    qefSolution = clamp(qefSolution, voxelMin, voxelMax);

    // 경계 버텍스 격자 스냅 (청크 경계 시각적 틈 완화)
    // 청크 이음새 완화: XZ 강한 스냅 + Y 소프트 스냅 (0.25 가중치)
    //   XZ: 완전 격자 스냅 → 청크 경계 XZ 연속성 보장
    //   Y: 소프트 스냅(가중치 0.25) → 높이 자유도 70% 유지 + 이음새 절벽 25% 완화
    bool isBX = (sid.x == 0 || sid.x >= N - 2);
    bool isBY = (sid.y == 0 || sid.y >= N - 2);
    bool isBZ = (sid.z == 0 || sid.z >= N - 2);
    // [Phase 1] featureType 기반 XZ Snap 강도 조정
    // featureType=1(Edge): Soft Snap 50% → 능선 버텍스가 격자와 QEF 해의 중간 위치
    // featureType=0,2: Hard Snap 100% (기존 유지 — 이음새 안정성 보장)
    int snapFT = ClassifyFeature(ATA);

    // [Phase 3] Edge 셀: Ridge 방향 1D 제약 릴랙세이션
    // ridgeDir 방향으로만 버텍스 이동 허용 → 계단형 → 단일 버텍스 체인
    // T-junction 방지: 이동 범위 AABB x 1.5 이내로 클램프
    // [Phase 3 안정성 가드]
    // ATA 행렬 크기(edgeCount 대용): trace가 너무 작으면 등방성 → ridgeDir 불안정
    // 최소 분산(trace/3)이 임계값 이상일 때만 릴랙세이션 실행
    float ataTrace = ATA[0][0] + ATA[1][1] + ATA[2][2];
    // [재귀검증] ataTrace ≈ edgeCount이므로 ataTrace > 0.5는 trivial 가드.
    // edgeCount >= 6: ATA가 충분히 결정되는 최소 에지 수. 6 미만은 릴랙세이션 제외.
    bool reliableRidge = (snapFT == 1) && (edgeCount >= 6);
    if (reliableRidge)
    {
        float3 ridgeDir = ComputeRidgeDir(ATA);
        // ridgeDir 안정성 체크: 크로스 결과가 의미 있어야 함
        float rLen = length(ridgeDir);
        if (rLen > 0.1)
        {
            ridgeDir /= rLen;
            float3 toQEF = qefSolution - massPoint;
            float t = dot(toQEF, ridgeDir);
            float tMin = -spacing * 0.75;
            float tMax =  spacing * 0.75;
            t = clamp(t, tMin, tMax);
            qefSolution = massPoint + ridgeDir * t;
            qefSolution = clamp(qefSolution, voxelMin, voxelMax);
        }
    }

    float xzSnapStrength = (snapFT == 1) ? 0.3 : 1.0; // Edge: 더 약한 Snap
    if (isBX)
    {
        float snappedX = round(qefSolution.x / spacing) * spacing;
        qefSolution.x = lerp(qefSolution.x, snappedX, xzSnapStrength);
    }
    if (isBY) // Y 소프트 스냅: QEF 해와 격자점 사이 25:75 혼합
    {
        float snappedY = round(qefSolution.y / spacing) * spacing;
        qefSolution.y = lerp(qefSolution.y, snappedY, 0.25);
    }
    if (isBZ) qefSolution.z = round(qefSolution.z / spacing) * spacing;
    qefSolution = clamp(qefSolution, voxelMin, voxelMax);

    float3 residual = qefSolution - massPoint;
    float qefError  = dot(residual, residual);
    int featureType = ClassifyFeature(ATA);

    int matIdx = 0;
    int oreType = ReadOreType(idx);
    if (oreType > 0) matIdx = (oreType >> 24) & 0xFF;

    // [FIX-5] 버텍스 노말 = 밀도 그래디언트 부호 반전
    //   기존: normalize(ATb) → ATb가 거의 0이거나 방향 불안정
    //   수정: 버텍스 위치의 밀도 그래디언트를 직접 샘플링, 내부 방향으로 반전
    // [개선-G] SolveQEF 버텍스 노말: ±2 가중 차분
    int3 gx1 = clamp(sid + int3(1,0,0), int3(0,0,0), int3(N-1,N-1,N-1));
    int3 gx0 = clamp(sid - int3(1,0,0), int3(0,0,0), int3(N-1,N-1,N-1));
    int3 gy1 = clamp(sid + int3(0,1,0), int3(0,0,0), int3(N-1,N-1,N-1));
    int3 gy0 = clamp(sid - int3(0,1,0), int3(0,0,0), int3(N-1,N-1,N-1));
    int3 gz1 = clamp(sid + int3(0,0,1), int3(0,0,0), int3(N-1,N-1,N-1));
    int3 gz0 = clamp(sid - int3(0,0,1), int3(0,0,0), int3(N-1,N-1,N-1));
    int3 gx2 = clamp(sid + int3(2,0,0), int3(0,0,0), int3(N-1,N-1,N-1));
    int3 gxm2= clamp(sid - int3(2,0,0), int3(0,0,0), int3(N-1,N-1,N-1));
    int3 gy2 = clamp(sid + int3(0,2,0), int3(0,0,0), int3(N-1,N-1,N-1));
    int3 gym2= clamp(sid - int3(0,2,0), int3(0,0,0), int3(N-1,N-1,N-1));
    int3 gz2 = clamp(sid + int3(0,0,2), int3(0,0,0), int3(N-1,N-1,N-1));
    int3 gzm2= clamp(sid - int3(0,0,2), int3(0,0,0), int3(N-1,N-1,N-1));
    float3 grad = float3(
        (ReadDensity(FlatIndex(gx1)) - ReadDensity(FlatIndex(gx0)))*0.8
        + (ReadDensity(FlatIndex(gx2)) - ReadDensity(FlatIndex(gxm2)))*0.2,
        (ReadDensity(FlatIndex(gy1)) - ReadDensity(FlatIndex(gy0)))*0.8
        + (ReadDensity(FlatIndex(gy2)) - ReadDensity(FlatIndex(gym2)))*0.2,
        (ReadDensity(FlatIndex(gz1)) - ReadDensity(FlatIndex(gz0)))*0.8
        + (ReadDensity(FlatIndex(gz2)) - ReadDensity(FlatIndex(gzm2)))*0.2
    );
    float gradLen = length(grad);
    float3 vertNormal_sid = gradLen > 1e-6 ? -grad / gradLen : float3(0, 1, 0);

    // [S2] QEF 위치에서 trilinear SDF 그라디언트 재계산
    // 실제 표면 위치(qefSolution)의 SDF 방향이 sid 기준보다 정확함
    // 천장-벽 경계: sid 기준은 X+ 편향, qefSolution 기준은 올바른 -Y
    float h = spacing * 0.5;
    float3 grad_qef = float3(
        SampleSDF_Safe(qefSolution + float3(h,0,0), spacing)
      - SampleSDF_Safe(qefSolution - float3(h,0,0), spacing),
        SampleSDF_Safe(qefSolution + float3(0,h,0), spacing)
      - SampleSDF_Safe(qefSolution - float3(0,h,0), spacing),
        SampleSDF_Safe(qefSolution + float3(0,0,h), spacing)
      - SampleSDF_Safe(qefSolution - float3(0,0,h), spacing)
    );
    float qefGradLen = length(grad_qef);
    // 이중 안정성 체크: S2 노말이 sid 노말의 10% 이상이어야 신뢰
    bool useS2 = (qefGradLen > 1e-5) && (qefGradLen > gradLen * 0.1);
    float3 vertNormal = useS2 ? -grad_qef / qefGradLen : vertNormal_sid;

    // [O1] WriteDCVertex — 압축/비압축 분기 헬퍼
    float2 vertUV = float2(qefSolution.x, qefSolution.z) * 0.1;
    WriteDCVertex(idx, qefSolution, vertNormal, vertUV, featureType, matIdx, qefError);
}

// ====================================================================
// Kernel 3: GenerateQuads
// ====================================================================
[numthreads(8, 8, 8)]
void GenerateQuads(uint3 id : SV_DispatchThreadID)
{
    int N = _PointsPerAxis;
    if ((int)id.x >= N - 1 || (int)id.y >= N - 1 || (int)id.z >= N - 1)
        return;

    int3 sid = (int3)id;
    int  idx = FlatIndex(sid);
    float d0 = ReadDensity(idx);

    int3 axisNeighbors[3];
    axisNeighbors[0] = int3(1, 0, 0);
    axisNeighbors[1] = int3(0, 1, 0);
    axisNeighbors[2] = int3(0, 0, 1);

    for (int axis = 0; axis < 3; axis++)
    {
        // [Gate 2 / B-α] Boundary Ownership — overlap edge 생성 skip
        //   sid[axis]=0 인 cell의 axis edge는 world position = chunkBasePos - 0.5*voxelSize
        //   → -axis neighbor chunk 담당 영역 (자기 영역 밖)
        //   → OFF(=0) 시 이 cell에서도 quad 생성 (기본 동작 — overlap 발생 지점)
        //   → ON(=1) 시 skip (자기 담당 edge만 생성 → mesh 중복 근본 제거)
        if (_EnableBoundaryOwnership != 0)
        {
            int axisIdx = (axis == 0) ? sid.x : ((axis == 1) ? sid.y : sid.z);
            if (axisIdx == 0) continue;
        }

        int3 nid = sid + axisNeighbors[axis];
        if (nid.x >= N || nid.y >= N || nid.z >= N)
            continue;

        float d1 = ReadDensity(FlatIndex(nid));

        if ((d0 > 0.0) == (d1 > 0.0))
            continue;
        // [Fix-Phantom v2] 허위 교차 필터 — 임계값 0.008 (voxelSize*0.5m의 1.6%)
        // 0.05는 과도하게 넓어 완만한 곡면 교차를 제거 → 구멍(hole) 발생
        // 0.008: 수치 노이즈 ε 수준만 제거, 실제 표면 교차는 보존
        if ((abs(d0) + abs(d1)) < 0.008)
            continue;

        int3 offsets[4];
        if (axis == 0)
        {
            offsets[0] = int3(0,  0,  0);
            offsets[1] = int3(0, -1,  0);
            offsets[2] = int3(0, -1, -1);
            offsets[3] = int3(0,  0, -1);
        }
        else if (axis == 1)
        {
            offsets[0] = int3( 0, 0,  0);
            offsets[1] = int3(-1, 0,  0);
            offsets[2] = int3(-1, 0, -1);
            offsets[3] = int3( 0, 0, -1);
        }
        else
        {
            offsets[0] = int3( 0,  0, 0);
            offsets[1] = int3(-1,  0, 0);
            offsets[2] = int3(-1, -1, 0);
            offsets[3] = int3( 0, -1, 0);
        }

        bool valid = true;
        int quadVerts[4];
        for (int i = 0; i < 4; i++)
        {
            int3 vid = sid + offsets[i];
            if (any(vid < int3(0,0,0)) || any(vid >= int3(N-1,N-1,N-1)))
            {
                valid = false;
                break;
            }

            // [Gate 2 / B-α 보강 — Quad vertex padding check (이중 안전장치)]
            //   SolveQEF에서 padding cell은 featureType=-1로 마크되므로 아래
            //   FIX-4 체크로 자동 차단. 하지만 방어적으로 index 기반으로도 명시.
            //   규칙 #6: OFF 시 이 체크 비활성 (기존 로직).
            if (_EnableBoundaryOwnership != 0)
            {
                if (vid.x == 0 || vid.y == 0 || vid.z == 0)
                {
                    valid = false;
                    break;
                }
            }

            int flatIdx = FlatIndex(vid);

            // [FIX-4] featureType=-1 → 무효 버텍스 → 쿼드 스킵
            if (_DCVertexBuffer[flatIdx].featureType < 0)
            {
                valid = false;
                break;
            }
            quadVerts[i] = flatIdx;
        }
        if (!valid) continue;

        // [FIX-6] 와인딩 방향 결정
        //   d>0=암석, d<0=공기 관례에서 수학적으로 검증된 공식:
        //     axis=0(X): 자연 법선=+X,  암석(d0>0)쪽이면 플립 불필요 → normalFlip=!(d0>0)
        //     axis=1(Y): 자연 법선=-Y,  암석(d0>0)이 아래라면 법선 +Y 필요 → normalFlip=(d0>0)
        //     axis=2(Z): 자연 법선=+Z,  axis=0과 동일 패턴 → normalFlip=!(d0>0)
        //   통합 공식: normalFlip = (d0>0) == (axis==1)
        //   (테스트 시 반전이 필요하다면 == → != 로 변경)
        bool normalFlip = (d0 > 0.0) == (axis == 1);

        DCQuad quad;
        if (normalFlip)
        {
            quad.v0 = quadVerts[3]; quad.v1 = quadVerts[2];
            quad.v2 = quadVerts[1]; quad.v3 = quadVerts[0];
        }
        else
        {
            quad.v0 = quadVerts[0]; quad.v1 = quadVerts[1];
            quad.v2 = quadVerts[2]; quad.v3 = quadVerts[3];
        }

        uint appendIdx;
        _QuadCount.InterlockedAdd(0, 1, appendIdx);

        // [FIX-7] 버퍼 오버플로우 방지
        int maxQuads = _PointsPerAxis * _PointsPerAxis * _PointsPerAxis;
        if ((int)appendIdx < maxQuads)
            _DCQuadBuffer[appendIdx] = quad;
    }
}

// ====================================================================
// [P1-B] Kernel: CompactAndRemap (옵션 D — InterlockedAdd)
//   유효 vertex(featureType>=0)만 _CompactVertexBuffer에 기록
//   _RemapTable[flatIdx] = compactIdx (무효=-1)
//   enableCompaction=ON 시 GenerateQuads 이후 실행
// ====================================================================
int _CompactBufferSize;  // N³

[numthreads(256, 1, 1)]
void CompactAndRemap(uint3 id : SV_DispatchThreadID)
{
    int flatIdx = (int)id.x;
    if (flatIdx >= _CompactBufferSize) return;

    // [O1] 압축/비압축 분기 — 두 구조체 모두 featureType 필드 보유
#ifdef COMPRESSED_VERTEX
    DCVertexCompressed v = _DCVertexBuffer[flatIdx];
#else
    DCVertex v = _DCVertexBuffer[flatIdx];
#endif
    if (v.featureType < 0)
    {
        _RemapTable[flatIdx] = -1;
        return;
    }

    uint compactIdx;
    _ValidVertexCount.InterlockedAdd(0, 1, compactIdx);

    // 오버플로우 방지 (이론상 N³ 이내)
    if ((int)compactIdx < _CompactBufferSize)
    {
        _CompactVertexBuffer[compactIdx] = v;
        _RemapTable[flatIdx] = (int)compactIdx;
    }
}

// ====================================================================
// [P1-B] Kernel: RemapQuads
//   quad.v0~v3의 flatIndex를 compactIdx로 변환
//   CompactAndRemap 이후 실행
// ====================================================================
int _RemapQuadCount;

[numthreads(256, 1, 1)]
void RemapQuads(uint3 id : SV_DispatchThreadID)
{
    int i = (int)id.x;
    if (i >= _RemapQuadCount) return;

    DCQuad q = _DCQuadBuffer[i];
    q.v0 = _RemapTable[q.v0];
    q.v1 = _RemapTable[q.v1];
    q.v2 = _RemapTable[q.v2];
    q.v3 = _RemapTable[q.v3];
    _DCQuadBuffer[i] = q;
}

// ═════════════════════════════════════════════════════════════════════════════
// [Phase 3-B / Gate 2-γ] ExtractBoundaryHermiteEdges kernel
//
// 목적:
//   CollectHermiteData kernel이 N³ × 3 = ~4M edges를 생성한 후,
//   6개 boundary face에 위치한 edges만 compact buffer로 추출 → CPU readback.
//   CPU는 이를 GhostEdgeSnapshot으로 포장해 neighbor chunk의 SolveQEF에 주입.
//
// 출력:
//   AppendStructuredBuffer<ExtractedGhostEdge> _BoundaryHermiteOutput
//   각 edge는 faceId 태그 (0=+X 1=-X 2=+Y 3=-Y 4=+Z 5=-Z) 포함 — CPU가 face별 분리.
//
// 주의:
//   - Corner cell은 여러 face에 중복 append됨 (의도됨 — AccumulateGhostEdges face별 처리).
//   - faceId 필드는 추출 전용 (shader의 GhostEdge struct에는 없음).
//
// 규칙 #3: CollectHermiteData kernel 미수정, 별도 kernel 분리.
// 규칙 #6: 호출 안 되면 no-op. _EnablePhase3GhostQEF=0 시 dispatcher가 skip.
// ═════════════════════════════════════════════════════════════════════════════

struct ExtractedGhostEdge
{
    float3 intersectionPoint;   // 12B (offset 0)
    float3 normal;              // 12B (offset 12)
    int    cellIndexLinear;     // 4B  (offset 24)
    int    edgeAxis;            // 4B  (offset 28)
    int    faceId;              // 4B  (offset 32) — 추출 전용 태그
    int    _pad;                // 4B  (offset 36) — 40B align
};
// Total: 40 bytes

AppendStructuredBuffer<ExtractedGhostEdge> _BoundaryHermiteOutput;

[numthreads(8, 8, 8)]
void ExtractBoundaryHermiteEdges(uint3 id : SV_DispatchThreadID)
{
    int3 sid = (int3)id;
    int N = _PointsPerAxis;

    // valid cell range: [0, N-2] (N-1 cells per axis, N-1인 index는 마지막 cell)
    // cell 0 = -축 boundary, cell N-2 = +축 boundary
    if (sid.x > N - 2 || sid.y > N - 2 || sid.z > N - 2) return;

    bool onPosX = (sid.x == N - 2);
    bool onNegX = (sid.x == 0);
    bool onPosY = (sid.y == N - 2);
    bool onNegY = (sid.y == 0);
    bool onPosZ = (sid.z == N - 2);
    bool onNegZ = (sid.z == 0);

    // 어느 boundary face에도 속하지 않으면 skip
    if (!(onPosX || onNegX || onPosY || onNegY || onPosZ || onNegZ)) return;

    float3 voxelCorner = GetVoxelLocalPos((uint3)sid);

    // 이 cell의 3 축 Hermite edges 순회
    [unroll]
    for (int axis = 0; axis < 3; axis++)
    {
        int edgeIdx = FlatIndex(sid) * 3 + axis;
        float3 iPos, iNrm;
        int readAxis;
        ReadHermiteEdge(edgeIdx, voxelCorner, iPos, iNrm, readAxis);

        // Invalid edge (normal zero/near-zero) skip
        if (length(iNrm) < 0.01) continue;

        // 이 cell이 속한 모든 face에 append (corner cell은 최대 3개 face에 중복)
        if (onPosX) {
            ExtractedGhostEdge ege;
            ege.intersectionPoint = iPos;
            ege.normal = iNrm;
            ege.cellIndexLinear = sid.y * N + sid.z;    // YZ plane
            ege.edgeAxis = axis;
            ege.faceId = 0;  // +X
            ege._pad = 0;
            _BoundaryHermiteOutput.Append(ege);
        }
        if (onNegX) {
            ExtractedGhostEdge ege;
            ege.intersectionPoint = iPos;
            ege.normal = iNrm;
            ege.cellIndexLinear = sid.y * N + sid.z;
            ege.edgeAxis = axis;
            ege.faceId = 1;  // -X
            ege._pad = 0;
            _BoundaryHermiteOutput.Append(ege);
        }
        if (onPosY) {
            ExtractedGhostEdge ege;
            ege.intersectionPoint = iPos;
            ege.normal = iNrm;
            ege.cellIndexLinear = sid.x * N + sid.z;    // XZ plane
            ege.edgeAxis = axis;
            ege.faceId = 2;
            ege._pad = 0;
            _BoundaryHermiteOutput.Append(ege);
        }
        if (onNegY) {
            ExtractedGhostEdge ege;
            ege.intersectionPoint = iPos;
            ege.normal = iNrm;
            ege.cellIndexLinear = sid.x * N + sid.z;
            ege.edgeAxis = axis;
            ege.faceId = 3;
            ege._pad = 0;
            _BoundaryHermiteOutput.Append(ege);
        }
        if (onPosZ) {
            ExtractedGhostEdge ege;
            ege.intersectionPoint = iPos;
            ege.normal = iNrm;
            ege.cellIndexLinear = sid.x * N + sid.y;    // XY plane
            ege.edgeAxis = axis;
            ege.faceId = 4;
            ege._pad = 0;
            _BoundaryHermiteOutput.Append(ege);
        }
        if (onNegZ) {
            ExtractedGhostEdge ege;
            ege.intersectionPoint = iPos;
            ege.normal = iNrm;
            ege.cellIndexLinear = sid.x * N + sid.y;
            ege.edgeAxis = axis;
            ege.faceId = 5;
            ege._pad = 0;
            _BoundaryHermiteOutput.Append(ege);
        }
    }
}
