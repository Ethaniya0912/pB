// =============================================================================
// CaveDualContouring.compute  |  pB-4 Project — Week 0
// =============================================================================
// [버그 수정 목록]
// FIX-1: GetVoxelWorldPos → GetVoxelLocalPos  (_ChunkOffset 제거, 순수 로컬 좌표)
// FIX-2: uint3 언더플로우 → int3 + clamp 으로 안전한 그래디언트 계산
// FIX-3: ClearHermiteBuffer 커널 추가 (청크 간 잔존 데이터 오염 방지)
// FIX-4: edgeCount==0 시 featureType=-1 마킹 (무효 버텍스 → 쿼드 생성 차단)
// FIX-5: 버텍스 노말 = 밀도 그래디언트 부호 반전 (동굴 내부 방향)
// FIX-6: 와인딩 = (d0>0) == (axis==1)  (d>0=암석 관례, 수학적 검증)
// FIX-7: GenerateQuads 버퍼 오버플로우 방지 (appendIdx 범위 체크)
// -----------------------------------------------------------------------------
// [O3 최적화 버그 수정]
// FIX-PHANTOM : SolveQEF — packedNormal==0u 직접 체크 추가
//   DecodeNormalOct16(0) = float3(0,0,-1) (length=1.0) 이므로 기존 length<0.01
//   가드로는 클리어된 슬롯이 걸러지지 않아 셀당 ~20개 팬텀 (0,0,-1) 기여 주입
//   → ATA[2][2]만 폭등, 모든 버텍스 Z좌표가 로컬 원점으로 snap → 블록형 메쉬
//   수정: if (edge.packedNormal == 0u) continue; 를 decode 이전에 삽입
// FIX-DC-A   : SolveQEF DC-A 블록 — ATA += 이전 bool로 ATb 조건 캡처
//   기존 코드는 ATA[i][i] += λ 이후 갱신된 값으로 ATb 조건 재평가
//   → 임계값 경계 셀에서 ATA·ATb λ 불일치 → QEF 해 왜곡
//   수정: weakX/Y/Z = (ATA[i][i] < diag_max*0.1) 를 += 이전에 캡처
// FIX-RIDGE  : hasDirectedAnisotropy 임계값 1.05 → 1.01
//   1.05이면 완만한 능선(두 고유값 5% 이내 유사)도 Phase 3 차단
//   → cave 지형 대부분의 floor-wall 전환부에서 Phase 3 미적용 → 능선 소멸
//   수정: 1.01로 완화, 순수 등방성 구면만 차단
// =============================================================================

#pragma kernel CollectHermiteData
#pragma kernel SolveQEF
#pragma kernel GenerateQuads
#pragma kernel ClearHermiteBuffer   // [FIX-3]
#pragma kernel ClearVertexBuffer    // [FIX-VERT] GPU 버텍스 클리어 (CPU SetData 대체)

// ============ 구조체 정의 (C# DCDataStructs와 동일) ============

struct CaveVoxel
{
    float density;
    int oreType;
    float2 padding;
};

// ──────────────────────────────────────────────────────────────────
// [O3] DCHermiteEdge 압축: 32B → 16B
//   intersectionNormal (float3 12B) → Oct16 packed uint (4B)
//   edgeAxis (4B) 제거: SolveQEF에서 미사용, edgeIdx로 내포
//   padding (4B) 제거
// ──────────────────────────────────────────────────────────────────
struct DCHermiteEdge
{
    float3 intersectionPoint;  // 12B  교차점 로컬 좌표
    uint   packedNormal;       //  4B  Oct16 인코딩 법선 (상위16=u, 하위16=v)
    // 합계: 16B (이전 32B)
};
// ── Oct16 인코딩/디코딩 (단위벡터 ↔ uint) ────────────────────────
float2 OctWrap(float2 v) {
    // [수정] HLSL bool2 삼항 연산자 버그 수정
    // 이전: (v.xy >= 0.0 ? 1.0 : -1.0) → bool2가 0/1로 처리돼 -1이 안 나옴
    // 이후: (2.0 * (float2)(v.xy >= 0.0) - 1.0) → 올바른 +1/-1 생성
    float2 signV = 2.0 * (float2)(v.xy >= 0.0) - 1.0;
    return (1.0 - abs(v.yx)) * signV;
}
uint EncodeNormalOct16(float3 n) {
    n /= (abs(n.x) + abs(n.y) + abs(n.z));
    float2 oct = n.z >= 0.0 ? n.xy : OctWrap(n.xy);
    oct = oct * 0.5 + 0.5;  // [-1,1] → [0,1]
    uint ux = (uint)(saturate(oct.x) * 65535.0 + 0.5);
    uint uy = (uint)(saturate(oct.y) * 65535.0 + 0.5);
    return (ux << 16) | uy;
}
float3 DecodeNormalOct16(uint packed) {
    float u = (float)((packed >> 16) & 0xFFFF) / 65535.0;
    float v = (float)(packed & 0xFFFF) / 65535.0;
    float2 oct = float2(u, v) * 2.0 - 1.0;  // [0,1] → [-1,1]
    float3 n = float3(oct.x, oct.y, 1.0 - abs(oct.x) - abs(oct.y));
    if (n.z < 0.0) { float2 w = OctWrap(n.xy); n.x = w.x; n.y = w.y; }
    return normalize(n);
}


struct DCVertex
{
    float3 position;      // 12B
    float3 normal;        // 12B
    int    featureType;   //  4B  -1=무효, 0=Smooth, 1=Edge, 2=Corner
    int    materialIndex; //  4B
    // 합계: 32B (이전 56B 대비 43% 절약)
    // 제거: uv(8B,worldPos재계산) qefError(4B,미사용) padding(12B)
};

struct DCQuad
{
    int v0, v1, v2, v3;
};

struct GameplaySculptData
{
    int wantNarrow;
    int wantHighGround;
    int wantDeadEnd;
    float ambushScore;
};

// ============ 버퍼 ============

RWStructuredBuffer<CaveVoxel>       _VoxelBuffer;
RWStructuredBuffer<DCHermiteEdge>   _HermiteEdgeBuffer;
RWStructuredBuffer<DCVertex>        _DCVertexBuffer;
RWStructuredBuffer<DCQuad>          _DCQuadBuffer;
RWByteAddressBuffer                 _QuadCount;
StructuredBuffer<GameplaySculptData> _GameplaySculptBuffer;

// ============ 유니폼 ============

int   _PointsPerAxis;
float _ChunkSize;       // = (PointsPerAxis - 1) * voxelSize  [FIX-1, FIX-2]
int   _HermiteBufferSize; // ClearHermiteBuffer용

// ============ 헬퍼 함수 ============

// [FIX-1] GetVoxelWorldPos → GetVoxelLocalPos
//   기존: _ChunkOffset(청크 정수 단위) + id*spacing → 잘못된 월드 좌표
//   수정: _ChunkOffset 제거, id*spacing만 반환 → 순수 로컬 좌표 [0, ChunkSize]
//   월드 배치는 CaveChunkManager가 chunkObj.transform.position으로 담당.
float3 GetVoxelLocalPos(uint3 id)
{
    float spacing = _ChunkSize / (float)(_PointsPerAxis - 1);
    return float3(id) * spacing;
}

// int3 오버로드 — clamp 결과에 사용
float3 GetVoxelLocalPosI(int3 id)
{
    float spacing = _ChunkSize / (float)(_PointsPerAxis - 1);
    return float3(id) * spacing;
}

int FlatIndex(int3 id)
{
    return id.x + id.y * _PointsPerAxis + id.z * _PointsPerAxis * _PointsPerAxis;
}

// ============ QEF 수학 함수 ============

float3 SolveQEF_Cholesky(float3x3 ATA, float3 ATb, float regLambda)
{
    ATA[0][0] += regLambda;
    ATA[1][1] += regLambda;
    ATA[2][2] += regLambda;

    float l00 = sqrt(max(ATA[0][0], 1e-10));
    float l10 = ATA[1][0] / l00;
    float l11 = sqrt(max(ATA[1][1] - l10 * l10, 1e-10));
    float l20 = ATA[2][0] / l00;
    float l21 = (ATA[2][1] - l20 * l10) / l11;
    float l22 = sqrt(max(ATA[2][2] - l20 * l20 - l21 * l21, 1e-10));

    float y0 = ATb.x / l00;
    float y1 = (ATb.y - l10 * y0) / l11;
    float y2 = (ATb.z - l20 * y0 - l21 * y1) / l22;

    float x2 = y2 / l22;
    float x1 = (y1 - l21 * x2) / l11;
    float x0 = (y0 - l10 * x1 - l20 * x2) / l00;

    return float3(x0, x1, x2);
}


// ====================================================================
// [Phase 3] Jacobi 3x3 대칭 행렬 고유값 분해
//   반복 10회 (GPU 상수 반복, 분기 없음)
//   출력: eigenvalues, eigenvectors (열 벡터)
// ====================================================================
void JacobiEigen3x3(float3x3 A, out float3 eigenvals, out float3x3 eigenvecs)
{
    float3x3 V = float3x3(1,0,0, 0,1,0, 0,0,1);
    float3x3 D = A;
    [unroll(10)]
    for (int iter = 0; iter < 10; iter++)
    {
        int3 pqs[3] = { int3(0,1,0), int3(0,2,0), int3(1,2,0) };
        for (int k = 0; k < 3; k++)
        {
            int p = pqs[k].x, q = pqs[k].y;
            float apq = D[p][q];
            if (abs(apq) < 1e-8) continue;
            float app = D[p][p], aqq = D[q][q];
            float theta = 0.5 * atan2(2.0 * apq, app - aqq);
            float c = cos(theta), s = sin(theta);
            float3x3 Rot = float3x3(1,0,0, 0,1,0, 0,0,1);
            Rot[p][p] =  c; Rot[p][q] = -s;
            Rot[q][p] =  s; Rot[q][q] =  c;
            D = mul(transpose(Rot), mul(D, Rot));
            V = mul(V, Rot);
        }
    }
    eigenvals = float3(D[0][0], D[1][1], D[2][2]);
    eigenvecs = V;
}

float3 ComputeRidgeDir(float3x3 ATA)
{
    float3 ev; float3x3 evec;
    JacobiEigen3x3(ATA, ev, evec);
    // 가장 큰 두 고유값의 고유벡터로 능선 방향 계산
    int i0=0, i1=1, i2=2;
    if (ev[i0] < ev[i1]) { int t=i0; i0=i1; i1=t; }
    if (ev[i0] < ev[i2]) { int t=i0; i0=i2; i2=t; }
    if (ev[i1] < ev[i2]) { int t=i1; i1=i2; i2=t; }
    float3 v0 = float3(evec[0][i0], evec[1][i0], evec[2][i0]);
    float3 v1 = float3(evec[0][i1], evec[1][i1], evec[2][i1]);
    float3 rDir = cross(v0, v1);
    float rLen = length(rDir);
    return rLen < 0.001 ? float3(0,1,0) : rDir / rLen;
}


// ====================================================================
// [S2] QEF 위치 Trilinear SDF 그라디언트 재샘플
//   qefSolution(실제 표면 위치)에서 SDF를 trilinear 보간으로 샘플
//   sid 기준 차분보다 실제 표면 법선 방향에 훨씬 가까운 노말을 생성
//   sampleStep 경계 처리: pos_v를 [0.5, N-1.5]로 클램프하여 경계 오류 방지
// ====================================================================
float SampleSDF_Safe(float3 pos_local, float spacing)
{
    float3 pos_v = pos_local / spacing;
    // 경계 마진: 반 셀 크기로 제한 → 경계 복셀 중복 샘플 방지
    int N = _PointsPerAxis;
    pos_v = clamp(pos_v, float3(0.5, 0.5, 0.5),
                         float3(N - 1.5, N - 1.5, N - 1.5));
    int3 c = (int3)floor(pos_v);
    float3 f = frac(pos_v);
    // 8코너 trilinear 보간
    float d000 = _VoxelBuffer[FlatIndex(c                  )].density;
    float d100 = _VoxelBuffer[FlatIndex(c + int3(1, 0, 0)) ].density;
    float d010 = _VoxelBuffer[FlatIndex(c + int3(0, 1, 0)) ].density;
    float d110 = _VoxelBuffer[FlatIndex(c + int3(1, 1, 0)) ].density;
    float d001 = _VoxelBuffer[FlatIndex(c + int3(0, 0, 1)) ].density;
    float d101 = _VoxelBuffer[FlatIndex(c + int3(1, 0, 1)) ].density;
    float d011 = _VoxelBuffer[FlatIndex(c + int3(0, 1, 1)) ].density;
    float d111 = _VoxelBuffer[FlatIndex(c + int3(1, 1, 1)) ].density;
    float dx00 = lerp(d000, d100, f.x);
    float dx10 = lerp(d010, d110, f.x);
    float dx01 = lerp(d001, d101, f.x);
    float dx11 = lerp(d011, d111, f.x);
    float dxy0 = lerp(dx00, dx10, f.y);
    float dxy1 = lerp(dx01, dx11, f.y);
    return lerp(dxy0, dxy1, f.z);
}

int ClassifyFeature(float3x3 ATA)
{
    float trace = ATA[0][0] + ATA[1][1] + ATA[2][2];
    float avg = trace / 3.0;
    float totalVar = abs(ATA[0][0] - avg) + abs(ATA[1][1] - avg) + abs(ATA[2][2] - avg);

    // [Phase 2] 상대 임계값 조정: 절대값(0.01/0.1) → 곡률 스케일 의존성 완화
    // 0.05: 완만한 곡면이 Edge로 오분류되는 현상 감소
    // 0.20: Corner 판정 범위 확대 (강한 모서리 보존)
    // [수정] smooth 임계값 0.05→0.08: 등방성 셀이 Edge로 오분류되는 것 방지
    // Edge→Corner 임계값 0.20→0.25: 더 강한 특징만 Corner 판정
    if (totalVar < 0.08) return 0;
    else if (totalVar < 0.25) return 1;
    else return 2;
}

// ====================================================================
// [FIX-3] Kernel 0: ClearHermiteBuffer
//   청크 디스패치 전 반드시 호출.
//   packedNormal = 0 → SolveQEF의 packedNormal==0 가드에서 자동 스킵. [O3]
// ====================================================================
[numthreads(256, 1, 1)]
void ClearHermiteBuffer(uint3 id : SV_DispatchThreadID)
{
    int i = (int)id.x;
    if (i >= _HermiteBufferSize) return;

    DCHermiteEdge cleared;
    cleared.intersectionPoint = float3(0, 0, 0);
    cleared.packedNormal      = 0; // [O3] 0 → SolveQEF에서 packedNormal==0 체크로 스킵
    _HermiteEdgeBuffer[i] = cleared;
}

// ====================================================================
// [FIX-VERT] Kernel: ClearVertexBuffer
//   청크 디스패치 전 호출. featureType=-1로 모든 버텍스 무효 마킹.
//   기존 CPU SetData(DCVertex[N3]) 대비:
//     - GPU에서 병렬 초기화 → 주 스레드 스톨 제거
//     - 약 6859 원소(N=19) 기준 CPU 0.3ms → GPU 0.01ms
// ====================================================================
[numthreads(256, 1, 1)]
void ClearVertexBuffer(uint3 id : SV_DispatchThreadID)
{
    int total = _PointsPerAxis * _PointsPerAxis * _PointsPerAxis;
    int i = (int)id.x;
    if (i >= total) return;

    DCVertex inv;
    inv.position      = float3(0, 0, 0);
    inv.normal        = float3(0, 1, 0);
    inv.featureType   = -1;   // 무효 마커: GenerateQuads가 참조 차단
    inv.materialIndex = 0;
    _DCVertexBuffer[i] = inv;
}

// ====================================================================
// Kernel 1: CollectHermiteData
// ====================================================================
[numthreads(8, 8, 8)]
void CollectHermiteData(uint3 id : SV_DispatchThreadID)
{
    int N = _PointsPerAxis;
    if ((int)id.x >= N - 1 || (int)id.y >= N - 1 || (int)id.z >= N - 1)
        return;

    int3 sid = (int3)id;
    int  idx = FlatIndex(sid);
    float d0 = _VoxelBuffer[idx].density;

    int3 axisNeighbors[3];
    axisNeighbors[0] = int3(1, 0, 0);
    axisNeighbors[1] = int3(0, 1, 0);
    axisNeighbors[2] = int3(0, 0, 1);

    for (int axis = 0; axis < 3; axis++)
    {
        int3 nid = sid + axisNeighbors[axis];
        if (nid.x >= N || nid.y >= N || nid.z >= N)
            continue;

        float d1 = _VoxelBuffer[FlatIndex(nid)].density;

        if ((d0 > 0.0) == (d1 > 0.0))
            continue;
        // [Fix-Phantom v2] 허위 교차 필터 — 임계값 0.008 (voxelSize*0.5m의 1.6%)
        // 0.05는 과도하게 넓어 완만한 곡면 교차를 제거 → 구멍(hole) 발생
        // 0.008: 수치 노이즈 ε 수준만 제거, 실제 표면 교차는 보존
        if ((abs(d0) + abs(d1)) < 0.008)
            continue;

        // 선형 보간 교차점
        float t = d0 / (d0 - d1);
        float3 p0 = GetVoxelLocalPos((uint3)sid);
        float3 p1 = GetVoxelLocalPos((uint3)nid);
        float3 intersection = lerp(p0, p1, t);

        // [FIX-2] uint3 언더플로우 → int3 + clamp
        //   기존: max(id - uint3(1,0,0), 0) → uint 언더플로우 발생
        //   수정: int3 산술 후 clamp([0, N-1])
        // [개선-G] ±2 가중 차분 → 고주파 SDF 노이즈 노말 안정화
        int3 px1 = clamp(sid + int3(1,0,0), int3(0,0,0), int3(N-1,N-1,N-1));
        int3 px0 = clamp(sid - int3(1,0,0), int3(0,0,0), int3(N-1,N-1,N-1));
        int3 py1 = clamp(sid + int3(0,1,0), int3(0,0,0), int3(N-1,N-1,N-1));
        int3 py0 = clamp(sid - int3(0,1,0), int3(0,0,0), int3(N-1,N-1,N-1));
        int3 pz1 = clamp(sid + int3(0,0,1), int3(0,0,0), int3(N-1,N-1,N-1));
        int3 pz0 = clamp(sid - int3(0,0,1), int3(0,0,0), int3(N-1,N-1,N-1));
        int3 px2 = clamp(sid + int3(2,0,0), int3(0,0,0), int3(N-1,N-1,N-1));
        int3 pxm2= clamp(sid - int3(2,0,0), int3(0,0,0), int3(N-1,N-1,N-1));
        int3 py2 = clamp(sid + int3(0,2,0), int3(0,0,0), int3(N-1,N-1,N-1));
        int3 pym2= clamp(sid - int3(0,2,0), int3(0,0,0), int3(N-1,N-1,N-1));
        int3 pz2 = clamp(sid + int3(0,0,2), int3(0,0,0), int3(N-1,N-1,N-1));
        int3 pzm2= clamp(sid - int3(0,0,2), int3(0,0,0), int3(N-1,N-1,N-1));
        float3 grad = float3(
            (_VoxelBuffer[FlatIndex(px1)].density - _VoxelBuffer[FlatIndex(px0)].density)*0.8
            + (_VoxelBuffer[FlatIndex(px2)].density - _VoxelBuffer[FlatIndex(pxm2)].density)*0.2,
            (_VoxelBuffer[FlatIndex(py1)].density - _VoxelBuffer[FlatIndex(py0)].density)*0.8
            + (_VoxelBuffer[FlatIndex(py2)].density - _VoxelBuffer[FlatIndex(pym2)].density)*0.2,
            (_VoxelBuffer[FlatIndex(pz1)].density - _VoxelBuffer[FlatIndex(pz0)].density)*0.8
            + (_VoxelBuffer[FlatIndex(pz2)].density - _VoxelBuffer[FlatIndex(pzm2)].density)*0.2
        );
        float gLen = length(grad);
        float3 normal = gLen > 1e-6 ? -grad / gLen : float3(0, 1, 0);

        int edgeIdx = FlatIndex(sid) * 3 + axis;
        DCHermiteEdge edge;
        edge.intersectionPoint = intersection;
        edge.packedNormal      = EncodeNormalOct16(normal); // [O3] Oct16 압축
        _HermiteEdgeBuffer[edgeIdx] = edge;
    }
}

// ====================================================================
// Kernel 2: SolveQEF
// ====================================================================
[numthreads(8, 8, 8)]
void SolveQEF(uint3 id : SV_DispatchThreadID)
{
    int N = _PointsPerAxis;
    if ((int)id.x >= N - 1 || (int)id.y >= N - 1 || (int)id.z >= N - 1)
        return;

    int3 sid = (int3)id;
    int  idx = FlatIndex(sid);

    float3x3 ATA = (float3x3)0;
    float3 ATb = float3(0, 0, 0);
    float3 massPoint = float3(0, 0, 0);
    int edgeCount = 0;
    float3 hermiteNormalSum = float3(0, 0, 0); // [FIX-NORMAL] hermite edge 법선 누적합

    for (int dx = 0; dx <= 1; dx++)
    for (int dy = 0; dy <= 1; dy++)
    for (int dz = 0; dz <= 1; dz++)
    {
        int3 nid = sid + int3(dx, dy, dz);
        if (nid.x >= N - 1 || nid.y >= N - 1 || nid.z >= N - 1)
            continue;

        int nIdx = FlatIndex(nid);
        for (int axis = 0; axis < 3; axis++)
        {
            int edgeIdx = nIdx * 3 + axis;
            DCHermiteEdge edge = _HermiteEdgeBuffer[edgeIdx];

            // [FIX-PHANTOM] 미기록 슬롯 직접 차단
            // DecodeNormalOct16(0) = float3(0,0,-1) (length=1.0) 이므로
            // 기존 length<0.01 가드는 팬텀 슬롯을 전혀 걸러내지 못함.
            // → raw 값을 먼저 확인하고, 0이면 즉시 스킵.
            if (edge.packedNormal == 0u) continue;
            // [O3] Oct16 디코딩: packedNormal → float3
            float3 n = DecodeNormalOct16(edge.packedNormal);
            if (length(n) < 0.01) continue; // 디코딩 결과 비정상 법선 추가 방어

            float3 p = edge.intersectionPoint;

            ATA[0][0] += n.x * n.x; ATA[0][1] += n.x * n.y; ATA[0][2] += n.x * n.z;
            ATA[1][0] += n.y * n.x; ATA[1][1] += n.y * n.y; ATA[1][2] += n.y * n.z;
            ATA[2][0] += n.z * n.x; ATA[2][1] += n.z * n.y; ATA[2][2] += n.z * n.z;

            float d = dot(n, p);
            ATb += n * d;

            massPoint += p;
            edgeCount++;
            hermiteNormalSum += n; // [FIX-NORMAL] 교차점 법선 누적
        }
    }

    // [FIX-4] edgeCount==0 → featureType=-1 마킹 (GenerateQuads에서 쿼드 차단)
    //   기존: return; → dcVertexBuffer[idx] = 버퍼 기본값(0) → featureType=0(유효로 오해)
    if (edgeCount == 0)
    {
        DCVertex invalid;
        invalid.position     = float3(0, 0, 0);
        invalid.normal       = float3(0, 1, 0);
        invalid.featureType  = -1;  // 무효 마커 (uv/qefError/padding 제거됨)
        invalid.materialIndex = 0;
        _DCVertexBuffer[idx] = invalid;
        return;
    }

    massPoint /= (float)edgeCount;

    // [DC-A] 불균등 λ regularization — 단일 축 지배 방지
    // 순수 단방향 표면에서 약한 두 축에 강한 regularization → massPoint 방향 안정화
    // normal 자체를 오염시키지 않고 QEF 해의 약한 축을 안정화
    //
    // [FIX-DC-A] ATb 조건을 ATA += 이전에 캡처
    // 기존 코드는 ATA[i][i] += 이후 갱신된 값으로 ATb 조건을 재평가,
    // 임계값 경계 근방 셀에서 ATA와 ATb의 λ 불일치 → QEF 해 왜곡.
    // 수정: weakX/Y/Z bool을 += 이전에 확정하여 ATA·ATb 정합성 보장.
    {
        float diag_max = max(max(ATA[0][0], ATA[1][1]), ATA[2][2]);
        bool weakX = (ATA[0][0] < diag_max * 0.1);
        bool weakY = (ATA[1][1] < diag_max * 0.1);
        bool weakZ = (ATA[2][2] < diag_max * 0.1);
        ATA[0][0] += weakX ? 0.10 : 0.01;
        ATA[1][1] += weakY ? 0.10 : 0.01;
        ATA[2][2] += weakZ ? 0.10 : 0.01;
        // ATb도 동일 비율로 massPoint 기여 추가 (Tikhonov regularization)
        ATb.x += weakX ? 0.10 * massPoint.x : 0.01 * massPoint.x;
        ATb.y += weakY ? 0.10 * massPoint.y : 0.01 * massPoint.y;
        ATb.z += weakZ ? 0.10 * massPoint.z : 0.01 * massPoint.z;
    }
    float3 qefSolution = SolveQEF_Cholesky(ATA, ATb, 0.0);  // λ이미 적용됨

    // 복셀 AABB 내 클램핑
    float spacing = _ChunkSize / (float)(_PointsPerAxis - 1);
    float3 voxelMin = GetVoxelLocalPos((uint3)sid);
    float3 voxelMax = voxelMin + float3(spacing, spacing, spacing);
    qefSolution = clamp(qefSolution, voxelMin, voxelMax);

    // 경계 버텍스 격자 스냅 (청크 경계 시각적 틈 완화)
    // 청크 이음새 완화: XZ 강한 스냅 + Y 소프트 스냅 (0.25 가중치)
    //   XZ: 완전 격자 스냅 → 청크 경계 XZ 연속성 보장
    //   Y: 소프트 스냅(가중치 0.25) → 높이 자유도 70% 유지 + 이음새 절벽 25% 완화
    bool isBX = (sid.x == 0 || sid.x >= N - 2);
    bool isBY = (sid.y == 0 || sid.y >= N - 2);
    bool isBZ = (sid.z == 0 || sid.z >= N - 2);
    // [Phase 1] featureType 기반 XZ Snap 강도 조정
    // featureType=1(Edge): Soft Snap 50% → 능선 버텍스가 격자와 QEF 해의 중간 위치
    // featureType=0,2: Hard Snap 100% (기존 유지 — 이음새 안정성 보장)
    int snapFT = ClassifyFeature(ATA);

    // [Phase 3] Edge 셀: Ridge 방향 1D 제약 릴랙세이션
    // ridgeDir 방향으로만 버텍스 이동 허용 → 계단형 → 단일 버텍스 체인
    // T-junction 방지: 이동 범위 AABB x 1.5 이내로 클램프
    // [Phase 3 안정성 가드 — FIX-RIDGE-GUARD v3]
    // 고유값 비율 체크: 등방성 표면(세 고유값 완전 동일)만 Phase 3 차단
    //
    // [FIX-THRESHOLD] 1.05 → 1.01:
    //   1.05이면 두 고유값이 5% 이내로 유사한 완만한 능선(floor-wall 45°)도 차단
    //   → backup 대비 Phase 3 미적용 범위 과대 → 능선 버텍스 격자 스냅
    //   1.01이면 수치적으로 거의 완전히 같은 세 고유값(순수 구면)만 차단
    //   → cave 지형의 대부분 능선 셀 Phase 3 통과 → backup 수준 능선 복원
    float3 ev_ridge; float3x3 evec_ridge;
    JacobiEigen3x3(ATA, ev_ridge, evec_ridge);
    float maxEV = max(max(ev_ridge[0], ev_ridge[1]), ev_ridge[2]);
    float minEV = min(min(ev_ridge[0], ev_ridge[1]), ev_ridge[2]);
    float midEV = ev_ridge[0] + ev_ridge[1] + ev_ridge[2] - maxEV - minEV;
    bool hasDirectedAnisotropy = (maxEV > midEV * 1.15) && (midEV > minEV * 1.15);

    // [FIX-FLOOR-RIDGE] 바닥/천장 면에서 Phase 3 릿지 억제
    // ATA 최대 고유값의 고유벡터 ≈ 표면 법선 방향
    // abs(dominantY) > 0.7 → 대략 45° 이내 수평면 → 바닥/천장
    // 바닥에 릿지가 생기면 도넛 링이 통행로를 침해 → Phase 3 차단
    int maxEVIdx = (ev_ridge[0] >= ev_ridge[1] && ev_ridge[0] >= ev_ridge[2]) ? 0 :
                   (ev_ridge[1] >= ev_ridge[2]) ? 1 : 2;
    float dominantY = abs(evec_ridge[1][maxEVIdx]);
    bool isFloorLike = dominantY > 0.7;

    bool reliableRidge = (snapFT == 1) && (edgeCount >= 6) && hasDirectedAnisotropy && !isFloorLike;
    if (reliableRidge)
    {
        int ri0=0, ri1=1, ri2=2;
        if (ev_ridge[ri0] < ev_ridge[ri1]) { int rt=ri0; ri0=ri1; ri1=rt; }
        if (ev_ridge[ri0] < ev_ridge[ri2]) { int rt=ri0; ri0=ri2; ri2=rt; }
        if (ev_ridge[ri1] < ev_ridge[ri2]) { int rt=ri1; ri1=ri2; ri2=rt; }
        float3 rv0 = float3(evec_ridge[0][ri0], evec_ridge[1][ri0], evec_ridge[2][ri0]);
        float3 rv1 = float3(evec_ridge[0][ri1], evec_ridge[1][ri1], evec_ridge[2][ri1]);
        float3 ridgeDir = cross(rv0, rv1);
        float rLen = length(ridgeDir);
        if (rLen > 0.1)
        {
            ridgeDir /= rLen;
            float3 toQEF = qefSolution - massPoint;
            float t = dot(toQEF, ridgeDir);
            float tMin = -spacing * 0.75;
            float tMax =  spacing * 0.75;
            t = clamp(t, tMin, tMax);

            // [FIX-RIDGE-BLEND] 100% ridgeDir 스냅 대신 60% 블렌딩
            // 100% 스냅: 능선이 날카로운 원형으로 정렬 → 도넛 각인
            // 60% 블렌딩: QEF 원래 해의 40%를 보존 → 부드러운 자연 능선
            float3 ridgeSolution = massPoint + ridgeDir * t;
            ridgeSolution = clamp(ridgeSolution, voxelMin, voxelMax);
            qefSolution = lerp(qefSolution, ridgeSolution, 0.6);
        }
    }

    float xzSnapStrength = (snapFT == 1) ? 0.3 : 1.0; // Edge: 더 약한 Snap
    if (isBX)
    {
        float snappedX = round(qefSolution.x / spacing) * spacing;
        qefSolution.x = lerp(qefSolution.x, snappedX, xzSnapStrength);
    }
    if (isBY) // Y 소프트 스냅: QEF 해와 격자점 사이 25:75 혼합
    {
        float snappedY = round(qefSolution.y / spacing) * spacing;
        qefSolution.y = lerp(qefSolution.y, snappedY, 0.25);
    }
    if (isBZ) qefSolution.z = round(qefSolution.z / spacing) * spacing;
    qefSolution = clamp(qefSolution, voxelMin, voxelMax);

    float3 residual = qefSolution - massPoint;
    float qefError  = dot(residual, residual);
    int featureType = ClassifyFeature(ATA);

    int matIdx = 0;
    int oreType = _VoxelBuffer[idx].oreType;
    if (oreType > 0) matIdx = (oreType >> 24) & 0xFF;

    // ── [REVERT-VNORMAL] vertex normal = vertNormal_sid 복원 ─────────────────────────
    // hermiteNormalSum(hermite 평균)이 chunk 편향(-Z 등)으로 수렴하는 문제로 롤백.
    //
    // 문제 요약:
    //   hermiteNormalSum이 chunk의 지배적 SDF 방향으로 100% 수렴
    //   → blendWeights 단일 축 지배 → X-facing 완전 줄무늬, floor dirt 소멸
    //
    // vertNormal_sid가 더 나은 이유:
    //   단일 SID 지점의 gradient → 인접 버텍스 간 SDF 변화 반영 → 더 다양
    //   곡면 지형에서 Y:Z ≈ 50:50 수렴 → X-facing/floor/Z-facing 모두 허용 가능
    //   hermiteNormalSum(더 넓은 영역 평균)보다 실제로 더 지역적으로 다양
    //
    // hermiteNormalSum은 ATA 계산에 영향을 주지 않으므로 누적 코드 유지.
    // (ATA는 루프 내에서 n을 직접 사용, hermiteNormalSum과 무관)
    //
    // [개선-G] SolveQEF 버텍스 노말: ±2 가중 차분
    int3 gx1 = clamp(sid + int3(1,0,0), int3(0,0,0), int3(N-1,N-1,N-1));
    int3 gx0 = clamp(sid - int3(1,0,0), int3(0,0,0), int3(N-1,N-1,N-1));
    int3 gy1 = clamp(sid + int3(0,1,0), int3(0,0,0), int3(N-1,N-1,N-1));
    int3 gy0 = clamp(sid - int3(0,1,0), int3(0,0,0), int3(N-1,N-1,N-1));
    int3 gz1 = clamp(sid + int3(0,0,1), int3(0,0,0), int3(N-1,N-1,N-1));
    int3 gz0 = clamp(sid - int3(0,0,1), int3(0,0,0), int3(N-1,N-1,N-1));
    int3 gx2 = clamp(sid + int3(2,0,0), int3(0,0,0), int3(N-1,N-1,N-1));
    int3 gxm2= clamp(sid - int3(2,0,0), int3(0,0,0), int3(N-1,N-1,N-1));
    int3 gy2 = clamp(sid + int3(0,2,0), int3(0,0,0), int3(N-1,N-1,N-1));
    int3 gym2= clamp(sid - int3(0,2,0), int3(0,0,0), int3(N-1,N-1,N-1));
    int3 gz2 = clamp(sid + int3(0,0,2), int3(0,0,0), int3(N-1,N-1,N-1));
    int3 gzm2= clamp(sid - int3(0,0,2), int3(0,0,0), int3(N-1,N-1,N-1));
    float3 grad_sid = float3(
        (_VoxelBuffer[FlatIndex(gx1)].density - _VoxelBuffer[FlatIndex(gx0)].density)*0.8
        + (_VoxelBuffer[FlatIndex(gx2)].density - _VoxelBuffer[FlatIndex(gxm2)].density)*0.2,
        (_VoxelBuffer[FlatIndex(gy1)].density - _VoxelBuffer[FlatIndex(gy0)].density)*0.8
        + (_VoxelBuffer[FlatIndex(gy2)].density - _VoxelBuffer[FlatIndex(gym2)].density)*0.2,
        (_VoxelBuffer[FlatIndex(gz1)].density - _VoxelBuffer[FlatIndex(gz0)].density)*0.8
        + (_VoxelBuffer[FlatIndex(gz2)].density - _VoxelBuffer[FlatIndex(gzm2)].density)*0.2
    );
    float gradLen_sid = length(grad_sid);
    float3 vertNormal = gradLen_sid > 1e-6 ? -grad_sid / gradLen_sid : float3(0, 1, 0);
    // ── [REVERT-VNORMAL END] ─────────────────────────────────────────────────────────

    // [O1+O2] DCVertex 압축: uv/qefError/padding 제거 → 56B→32B
    DCVertex vert;
    vert.position      = qefSolution;
    vert.normal        = vertNormal;
    vert.featureType   = featureType;
    vert.materialIndex = matIdx;


    _DCVertexBuffer[idx] = vert;
}

// ====================================================================
// Kernel 3: GenerateQuads
// ====================================================================
[numthreads(8, 8, 8)]
void GenerateQuads(uint3 id : SV_DispatchThreadID)
{
    int N = _PointsPerAxis;
    if ((int)id.x >= N - 1 || (int)id.y >= N - 1 || (int)id.z >= N - 1)
        return;

    int3 sid = (int3)id;
    int  idx = FlatIndex(sid);
    float d0 = _VoxelBuffer[idx].density;

    int3 axisNeighbors[3];
    axisNeighbors[0] = int3(1, 0, 0);
    axisNeighbors[1] = int3(0, 1, 0);
    axisNeighbors[2] = int3(0, 0, 1);

    for (int axis = 0; axis < 3; axis++)
    {
        int3 nid = sid + axisNeighbors[axis];
        if (nid.x >= N || nid.y >= N || nid.z >= N)
            continue;

        float d1 = _VoxelBuffer[FlatIndex(nid)].density;

        if ((d0 > 0.0) == (d1 > 0.0))
            continue;
        // [Fix-Phantom v2] 허위 교차 필터 — 임계값 0.008 (voxelSize*0.5m의 1.6%)
        // 0.05는 과도하게 넓어 완만한 곡면 교차를 제거 → 구멍(hole) 발생
        // 0.008: 수치 노이즈 ε 수준만 제거, 실제 표면 교차는 보존
        if ((abs(d0) + abs(d1)) < 0.008)
            continue;

        int3 offsets[4];
        if (axis == 0)
        {
            offsets[0] = int3(0,  0,  0);
            offsets[1] = int3(0, -1,  0);
            offsets[2] = int3(0, -1, -1);
            offsets[3] = int3(0,  0, -1);
        }
        else if (axis == 1)
        {
            offsets[0] = int3( 0, 0,  0);
            offsets[1] = int3(-1, 0,  0);
            offsets[2] = int3(-1, 0, -1);
            offsets[3] = int3( 0, 0, -1);
        }
        else
        {
            offsets[0] = int3( 0,  0, 0);
            offsets[1] = int3(-1,  0, 0);
            offsets[2] = int3(-1, -1, 0);
            offsets[3] = int3( 0, -1, 0);
        }

        bool valid = true;
        int quadVerts[4];
        for (int i = 0; i < 4; i++)
        {
            int3 vid = sid + offsets[i];
            if (any(vid < int3(0,0,0)) || any(vid >= int3(N-1,N-1,N-1)))
            {
                valid = false;
                break;
            }
            int flatIdx = FlatIndex(vid);

            // [FIX-4] featureType=-1 → 무효 버텍스 → 쿼드 스킵
            if (_DCVertexBuffer[flatIdx].featureType < 0)
            {
                valid = false;
                break;
            }
            quadVerts[i] = flatIdx;
        }
        if (!valid) continue;

        // [FIX-6] 와인딩 방향 결정
        //   d>0=암석, d<0=공기 관례에서 수학적으로 검증된 공식:
        //     axis=0(X): 자연 법선=+X,  암석(d0>0)쪽이면 플립 불필요 → normalFlip=!(d0>0)
        //     axis=1(Y): 자연 법선=-Y,  암석(d0>0)이 아래라면 법선 +Y 필요 → normalFlip=(d0>0)
        //     axis=2(Z): 자연 법선=+Z,  axis=0과 동일 패턴 → normalFlip=!(d0>0)
        //   통합 공식: normalFlip = (d0>0) == (axis==1)
        //   (테스트 시 반전이 필요하다면 == → != 로 변경)
        bool normalFlip = (d0 > 0.0) == (axis == 1);

        DCQuad quad;
        if (normalFlip)
        {
            quad.v0 = quadVerts[3]; quad.v1 = quadVerts[2];
            quad.v2 = quadVerts[1]; quad.v3 = quadVerts[0];
        }
        else
        {
            quad.v0 = quadVerts[0]; quad.v1 = quadVerts[1];
            quad.v2 = quadVerts[2]; quad.v3 = quadVerts[3];
        }

        uint appendIdx;
        _QuadCount.InterlockedAdd(0, 1, appendIdx);

        // [FIX-7] 버퍼 오버플로우 방지
        int maxQuads = _PointsPerAxis * _PointsPerAxis * _PointsPerAxis;
        if ((int)appendIdx < maxQuads)
            _DCQuadBuffer[appendIdx] = quad;
    }
}
