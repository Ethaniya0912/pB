// =============================================================================
// CaveDensityGenerator_SinkholeExt.compute
// 싱크홀 SDF Room 노드 마스킹 확장
// -----------------------------------------------------------------------------
// 진단 배경:
//   싱크홀이 Room 노드뿐 아니라 Corridor(통로) 영역에도 무차별 적용되어
//   통로 SDF와 교차할 때 링/도넛 형태의 비정상 메쉬가 생성됨.
//   석회암(Terrace=1)만 사용해도 동일 발생 → Terrace Steps 무관.
//
// 해결 접근:
//   각 복셀 좌표에서 가장 가까운 노드의 타입을 확인하고,
//   Room 타입에 해당할 때만 싱크홀 SDF를 적용.
//   기존 CaveDensityGenerator.compute에 이 커널을 추가하거나
//   별도 패스로 실행 후 메인 밀도 버퍼에 합산.
// =============================================================================

#pragma kernel ApplySinkholesMasked
#pragma kernel ClearSinkholeBuffer

// ─────────────────────────────────────────────────────────────────────────────
// 데이터 구조
// ─────────────────────────────────────────────────────────────────────────────

// Room 노드 데이터 (CaveNodeGraphBuilder에서 Room 타입만 필터해서 전달)
struct RoomNodeData
{
    float3 position;        // 월드 좌표 중심
    float  voronoiRadius;   // Room의 영향 반경 (Corridor와 경계 판정용)
    float  sinkholeRadius;  // 이 방에 생성될 싱크홀 반경 (0이면 싱크홀 없음)
    float  sinkholeDepth;   // 천장에서 내려오는 깊이
    float  sinkholeOffX;    // 방 중심에서 X 오프셋 (랜덤 위치 조정)
    float  sinkholeOffZ;    // 방 중심에서 Z 오프셋
    int    hasSinkhole;     // 0=없음, 1=있음 (Sinkhole P 확률로 결정)
};

// Corridor 노드 (거리 판정용 — 위치만 필요)
struct CorridorNodeData
{
    float3 posA;            // 통로 시작점
    float3 posB;            // 통로 끝점
    float  radius;          // 통로 반경
};

StructuredBuffer<RoomNodeData>     _RoomNodes;
StructuredBuffer<CorridorNodeData> _CorridorNodes;
int _RoomNodeCount;
int _CorridorNodeCount;

// 메인 밀도 버퍼 (읽기/쓰기)
RWStructuredBuffer<float> _DensityBuffer; // CaveDensityGenerator의 출력 밀도 버퍼

// 그리드 파라미터
int   _PointsPerAxis;
float _VoxelSize;
float3 _ChunkOrigin;        // 이 청크의 월드 좌표 오리진

// SDF 스무딩 파라미터
float _SinholeBlendK;       // smoothSubtraction k값 (권장: 1.0~2.0)

// ─────────────────────────────────────────────────────────────────────────────
// 유틸리티 함수
// ─────────────────────────────────────────────────────────────────────────────

int FlatIndex(int3 id, int N)
{
    return id.x * N * N + id.y * N + id.z;
}

float3 VoxelWorldPos(int3 id, int N)
{
    return _ChunkOrigin + (float3(id) / float(N - 1)) * (_VoxelSize * float(N - 1));
}

// smoothSubtraction: base SDF에서 subtractor를 부드럽게 빼냄
// 결과: base 내에서 subtractor가 있는 부분을 air로 만듦
float SmoothSubtraction(float base, float subtractor, float k)
{
    float h = saturate(0.5 - 0.5 * (base + subtractor) / k);
    return lerp(base, -subtractor, h) + k * h * (1.0 - h);
}

// 싱크홀 SDF: 수직 원기둥으로 천장부를 아래로 뚫음
// 반환값 < 0 = 싱크홀 내부(air)
float SinkholeSDF(float3 p, float3 center, float radius, float depth, float offX, float offZ)
{
    float3 sinkholeCenter = center + float3(offX, 0, offZ);
    // XZ 평면에서 원기둥 내부 여부
    float xzDist = length(p.xz - sinkholeCenter.xz) - radius;
    // Y축: 방 상단(center.y)에서 위로 depth만큼 뚫음 (천장 방향)
    float yClip  = p.y - (center.y + depth); // center.y+depth 위는 모두 포함
    // 원기둥과 Y 제한의 교집합
    return max(xzDist, -yClip); // 음수 = 싱크홀 내부
}

// 점 P와 선분 AB 사이의 최근접 거리 (Corridor 거리 판정)
float PointToSegmentDist(float3 p, float3 a, float3 b)
{
    float3 ab = b - a;
    float t = saturate(dot(p - a, ab) / max(dot(ab, ab), 0.0001));
    float3 closest = a + t * ab;
    return length(p - closest);
}

// ─────────────────────────────────────────────────────────────────────────────
// 커널: ApplySinkholesMasked
// 각 복셀이 Room 영역인지 Corridor 영역인지 판정 후, Room에만 싱크홀 적용
// ─────────────────────────────────────────────────────────────────────────────
[numthreads(8, 8, 8)]
void ApplySinkholesMasked(uint3 id : SV_DispatchThreadID)
{
    int N = _PointsPerAxis;
    if ((int)id.x >= N || (int)id.y >= N || (int)id.z >= N) return;

    int   flatIdx = FlatIndex((int3)id, N);
    float3 worldP = VoxelWorldPos((int3)id, N);

    float currentDensity = _DensityBuffer[flatIdx];

    // ── Step 1: 가장 가까운 Room 노드 찾기 ─────────────────────────────────
    float  nearestRoomDist  = 1e9;
    int    nearestRoomIdx   = -1;
    for (int r = 0; r < _RoomNodeCount; r++)
    {
        float d = length(worldP.xz - _RoomNodes[r].position.xz);
        if (d < nearestRoomDist)
        {
            nearestRoomDist = d;
            nearestRoomIdx  = r;
        }
    }

    // ── Step 2: 가장 가까운 Corridor까지의 거리 ────────────────────────────
    float nearestCorridorDist = 1e9;
    for (int c = 0; c < _CorridorNodeCount; c++)
    {
        float d = PointToSegmentDist(worldP,
                                     _CorridorNodes[c].posA,
                                     _CorridorNodes[c].posB)
                  - _CorridorNodes[c].radius;
        nearestCorridorDist = min(nearestCorridorDist, d);
    }

    // ── Step 3: Voronoi 판정 ────────────────────────────────────────────────
    // 이 복셀이 Room 영역에 속하는가?
    // Room의 voronoiRadius 내부이고, 가장 가까운 Corridor보다 Room이 더 가까운 경우
    bool isRoomRegion = (nearestRoomIdx >= 0)
        && (nearestRoomDist < _RoomNodes[nearestRoomIdx].voronoiRadius)
        && (nearestRoomDist <= nearestCorridorDist + 0.5); // 0.5m 마진

    // ── Step 4: Room 영역에만 싱크홀 SDF 적용 ──────────────────────────────
    if (isRoomRegion && nearestRoomIdx >= 0)
    {
        RoomNodeData room = _RoomNodes[nearestRoomIdx];
        if (room.hasSinkhole == 1 && room.sinkholeRadius > 0.0)
        {
            float sinkSDF = SinkholeSDF(
                worldP,
                room.position,
                room.sinkholeRadius,
                room.sinkholeDepth,
                room.sinkholeOffX,
                room.sinkholeOffZ
            );

            // smoothSubtraction: 싱크홀 내부를 부드럽게 air로 만듦
            // currentDensity > 0 (암석)이고 sinkSDF < 0 (싱크홀 내부)인 곳이 뚫림
            _DensityBuffer[flatIdx] = SmoothSubtraction(currentDensity, -sinkSDF, _SinholeBlendK);
        }
    }
    // Corridor 영역: 아무것도 하지 않음 → 통로 형태 보존
}

// ─────────────────────────────────────────────────────────────────────────────
// 커널: ClearSinkholeBuffer (디버그/리셋용)
// ─────────────────────────────────────────────────────────────────────────────
[numthreads(256, 1, 1)]
void ClearSinkholeBuffer(uint3 id : SV_DispatchThreadID)
{
    int N = _PointsPerAxis;
    int N3 = N * N * N;
    if ((int)id.x >= N3) return;
    // 싱크홀 버퍼 초기화 — 필요 시 사용
}

