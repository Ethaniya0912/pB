// ===============================================================================
// 파일: CaveDensityGenerator.compute
// 역할: 3D 공간 밀도 연산 및 물리 기반 수력 침식(Hydraulic Erosion) 시뮬레이션
// 구조: Multi-Kernel (GenerateDensity -> SimulateErosion)
// ===============================================================================
#pragma kernel GenerateDensity
#pragma kernel SimulateErosion

#include "CaveDataStructs.hlsl"

// --- [버퍼 및 전역 변수 설정] ---
RWStructuredBuffer<CaveVoxel> _VoxelBuffer;

struct BoundingBox
{
    float3 minBounds;
    float3 maxBounds;
};
StructuredBuffer<BoundingBox> _FixedZones;
int _FixedZoneCount;

float3 _ChunkBasePosition;
int _ChunkSize;
float _VoxelSize;

float _NoiseScale;
int _Octaves;
float _Lacunarity;
float _Gain;
float _SdfSmoothness;
float _WaterLevel;
float _WarpStrength;
float _WarpFreq;

int _DebugStage;

// --- [유틸리티 및 해시 함수] ---

float3 hash33(float3 p)
{
    p = float3(dot(p, float3(127.1, 311.7, 74.7)),
               dot(p, float3(269.5, 183.3, 246.1)),
               dot(p, float3(113.5, 271.9, 124.6)));
    return frac(sin(p) * 43758.5453123);
}

float2 hash22(float2 p)
{
    p = float2(dot(p, float2(127.1, 311.7)), dot(p, float2(269.5, 183.3)));
    return frac(sin(p) * 43758.5453123);
}

// 1D 난수 생성기 (Erosion 입자 생성용)
uint wang_hash(uint seed)
{
    seed = (seed ^ 61) ^ (seed >> 16);
    seed *= 9;
    seed = seed ^ (seed >> 4);
    seed *= 0x27d4eb2d;
    seed = seed ^ (seed >> 15);
    return seed;
}

float randomFloat(inout uint state)
{
    state = wang_hash(state);
    return (float) state / 4294967296.0;
}

float snoise(float3 x)
{
    float3 p = floor(x);
    float3 f = frac(x);
    f = f * f * (3.0 - 2.0 * f);

    float n = p.x + p.y * 157.0 + 113.0 * p.z;
    float4 h = frac(sin(float4(n, n + 1.0, n + 157.0, n + 158.0)) * 43758.5453);
    float4 h2 = frac(sin(float4(n + 113.0, n + 114.0, n + 270.0, n + 271.0)) * 43758.5453);
    
    float2 res1 = lerp(h.xy, h.zw, f.y);
    float2 res2 = lerp(h2.xy, h2.zw, f.y);
    float res3 = lerp(res1.x, res1.y, f.x);
    float res4 = lerp(res2.x, res2.y, f.x);
    return lerp(res3, res4, f.z) * 2.0 - 1.0;
}

float snoise2D(float2 x)
{
    float2 p = floor(x);
    float2 f = frac(x);
    f = f * f * (3.0 - 2.0 * f);
    float n = p.x + p.y * 157.0;
    float3 h = frac(sin(float3(n, n + 1.0, n + 157.0)) * 43758.5453);
    float res1 = lerp(h.x, h.y, f.x);
    float res2 = lerp(h.y, h.z, f.x);
    return lerp(res1, res2, f.y) * 2.0 - 1.0;
}

float fBm(float3 p)
{
    float sum = 0.0;
    float amp = 1.0;
    float freq = 1.0;
    for (int i = 0; i < _Octaves; i++)
    {
        sum += snoise(p * freq) * amp;
        freq *= _Lacunarity;
        amp *= _Gain;
    }
    return sum;
}

float fBm2D(float2 p)
{
    float sum = 0.0;
    float amp = 1.0;
    float freq = 1.0;
    for (int i = 0; i < 3; i++)
    {
        sum += snoise2D(p * freq) * amp;
        freq *= _Lacunarity;
        amp *= _Gain;
    }
    return sum;
}

void Voronoi(float3 p, out float f1, out float f2)
{
    float3 n = floor(p);
    float3 f = frac(p);
    f1 = 8.0;
    f2 = 8.0;
    for (int k = -1; k <= 1; k++)
        for (int j = -1; j <= 1; j++)
            for (int i = -1; i <= 1; i++)
            {
                float3 g = float3(float(i), float(j), float(k));
                float d = dot(g - f + hash33(n + g), g - f + hash33(n + g));
                if (d < f1)
                {
                    f2 = f1;
                    f1 = d;
                }
                else if (d < f2)
                {
                    f2 = d;
                }
            }
    f1 = sqrt(f1);
    f2 = sqrt(f2);
}

float Voronoi2D(float2 p)
{
    float2 n = floor(p);
    float2 f = frac(p);
    float f1 = 8.0;
    for (int j = -1; j <= 1; j++)
        for (int i = -1; i <= 1; i++)
        {
            float2 g = float2(float(i), float(j));
            float d = dot(g - f + hash22(n + g), g - f + hash22(n + g));
            if (d < f1)
                f1 = d;
        }
    return sqrt(f1);
}

float smin(float a, float b, float k)
{
    float h = clamp(0.5 + 0.5 * (b - a) / k, 0.0, 1.0);
    return lerp(b, a, h) - k * h * (1.0 - h);
}

float smax(float a, float b, float k)
{
    float h = clamp(0.5 - 0.5 * (b - a) / k, 0.0, 1.0);
    return lerp(b, a, h) + k * h * (1.0 - h);
}

float sdBox(float3 p, float3 b)
{
    float3 d = abs(p) - b;
    return length(max(d, 0.0)) + min(max(d.x, max(d.y, d.z)), 0.0);
}

int GetVoxelIndex(int x, int y, int z)
{
    return x + y * _ChunkSize + z * _ChunkSize * _ChunkSize;
}

// 3D 밀도장의 Gradient (Normal)를 구하는 함수 (침식 커널에서도 사용됨)
float3 CalculateGradientNormal(int x, int y, int z)
{
    int nx = max(0, x - 1);
    int px = min(_ChunkSize - 1, x + 1);
    int ny = max(0, y - 1);
    int py = min(_ChunkSize - 1, y + 1);
    int nz = max(0, z - 1);
    int pz = min(_ChunkSize - 1, z + 1);

    float dx = _VoxelBuffer[GetVoxelIndex(px, y, z)].density - _VoxelBuffer[GetVoxelIndex(nx, y, z)].density;
    float dy = _VoxelBuffer[GetVoxelIndex(x, py, z)].density - _VoxelBuffer[GetVoxelIndex(x, ny, z)].density;
    float dz = _VoxelBuffer[GetVoxelIndex(x, y, pz)].density - _VoxelBuffer[GetVoxelIndex(x, y, nz)].density;

    return normalize(float3(-dx, -dy, -dz));
}

// ===============================================================================
// 커널 1: 기본 지형 뼈대 및 밀도 생성 (3D 스레드)
// ===============================================================================
[numthreads(8, 8, 8)]
void GenerateDensity(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint) _ChunkSize || id.y >= (uint) _ChunkSize || id.z >= (uint) _ChunkSize)
        return;
    int index = GetVoxelIndex(id.x, id.y, id.z);
    float3 worldPos = _ChunkBasePosition + (id * _VoxelSize);
    
    // 1. 도메인 워핑
    float3 warpNoise = float3(snoise(worldPos * _WarpFreq), snoise(worldPos * _WarpFreq + 15.2), snoise(worldPos * _WarpFreq - 32.1));
    float3 warpedPos = worldPos + (warpNoise * _WarpStrength);

    // 2. Hub & Spoke 뼈대 SDF
    float f1, f2;
    Voronoi(warpedPos * _NoiseScale * 0.5, f1, f2);
    float baseDensity = min(f1 - 0.35, (f2 - f1) - 0.15) * 40.0;

    if (_DebugStage == 0)
    {
        _VoxelBuffer[index].density = baseDensity;
        return;
    }

    // 3. 고정 구역 마스킹
    float fixedZoneSDF = 9999.0;
    for (int i = 0; i < _FixedZoneCount; i++)
    {
        float3 center = (_FixedZones[i].minBounds + _FixedZones[i].maxBounds) * 0.5;
        float3 extents = (_FixedZones[i].maxBounds - _FixedZones[i].minBounds) * 0.5;
        fixedZoneSDF = min(fixedZoneSDF, sdBox(worldPos - center, extents));
    }
    baseDensity = smin(baseDensity, fixedZoneSDF, _SdfSmoothness * 2.0);

    // 4. 바닥 평탄화
    float layerY = floor(worldPos.y / 50.0) * 50.0 + 25.0;
    float floorPlane = layerY - worldPos.y + (fBm2D(warpedPos.xz * _NoiseScale * 2.0) * 3.0);
    baseDensity = smax(baseDensity, -floorPlane, 5.0);

    if (_DebugStage == 1)
    {
        _VoxelBuffer[index].density = baseDensity;
        return;
    }

    // 5. 마크로 바이옴 혼합
    float biomeBlend = snoise(worldPos * 0.005) * 0.5 + 0.5;
    float karstNoise = fBm(float3(warpedPos.x, warpedPos.y * 0.25, warpedPos.z) * _NoiseScale * 2.0) * 12.0;
    float columnarNoise = step(0.15, 1.0 - Voronoi2D(worldPos.xz * 0.2)) * 15.0 - 5.0;
    float terrace = (floor(warpedPos.y * 2.0) / 2.0) - warpedPos.y;
    float sediNoise = terrace * 10.0 + fBm(warpedPos * _NoiseScale * 1.5) * 3.0;

    float detailNoise = biomeBlend < 0.33 ? lerp(karstNoise, columnarNoise, smoothstep(0.0, 0.33, biomeBlend)) :
                       (biomeBlend < 0.66 ? lerp(columnarNoise, sediNoise, smoothstep(0.33, 0.66, biomeBlend)) : sediNoise);

    // 6. Surface Attenuation
    float attenuation = smoothstep(20.0, 0.0, abs(baseDensity));
    float finalDensity = baseDensity + (detailNoise * attenuation);

    CaveVoxel finalVoxel;
    finalVoxel.density = finalDensity;
    finalVoxel.oreType = (abs(finalDensity) < 2.0 && snoise(worldPos * 0.5) > 0.6) ? 1 : 0;
    
    _VoxelBuffer[index] = finalVoxel;
}

// ===============================================================================
// 커널 2: 물리 기반 수력 침식 (Hydraulic Erosion) & 열 퇴화 (1D 스레드)
// ===============================================================================
[numthreads(64, 1, 1)]
void SimulateErosion(uint3 id : SV_DispatchThreadID)
{
    // 디버그 설정이 4(ErosionSimulated) 미만이면 침식 연산 스킵
    if (_DebugStage < 4)
        return;

    // 입자 난수 초기화 (청크 위치와 고유 ID 조합)
    uint state = id.x + (uint) _ChunkBasePosition.x * 73856 + (uint) _ChunkBasePosition.z * 1920;
    
    // 입자를 청크 최상단 무작위 좌표에 생성
    float3 pos = float3(randomFloat(state) * (_ChunkSize - 1),
                        _ChunkSize - 2.0,
                        randomFloat(state) * (_ChunkSize - 1));

    float3 dir = float3(0, 0, 0);
    float speed = 1.0;
    float water = 1.0;
    float sediment = 0.0;

    // 물리 상수
    float dt = 0.1;
    float evapRate = 0.02; // 증발률
    float capacityFactor = 1.5; // 수용력 배수
    float minCapacity = 0.05; // 최소 수용력
    float erosionRate = 0.1; // 깎는 속도
    float depositionRate = 0.2; // 쌓는 속도

    // 물방울 생애 주기 루프 (최대 64번 이동)
    for (int step = 0; step < 64; step++)
    {
        int3 ipos = int3(pos);
        
        // 청크 바운더리를 벗어나면 소멸
        if (ipos.x < 0 || ipos.y < 1 || ipos.z < 0 ||
            ipos.x >= _ChunkSize || ipos.y >= _ChunkSize || ipos.z >= _ChunkSize)
            break;

        int voxelIdx = GetVoxelIndex(ipos.x, ipos.y, ipos.z);
        float currentDensity = _VoxelBuffer[voxelIdx].density;

        // 밀도가 음수(공기)면 중력을 받아 낙하
        if (currentDensity < -0.1)
        {
            pos.y -= 1.0;
            continue;
        }

        // --- 표면 충돌 및 흐름(Flow) 계산 ---
        float3 normal = CalculateGradientNormal(ipos.x, ipos.y, ipos.z);
        float3 gravity = float3(0, -1, 0);
        
        // 지형의 경사도 (1.0 = 평지, 0.0 = 수직 절벽)
        float slope = max(0.0, dot(normal, float3(0, 1, 0)));
        
        // 중력 벡터를 표면 탄젠트 평면에 투영하여 흐르는 방향 도출
        float3 flowDir = normalize(gravity - normal * dot(gravity, normal));

        // 평지에 도달하거나 구석에 갇혔다면 가진 흙을 모두 쏟고 소멸
        if (length(flowDir) < 0.01 || slope > 0.99)
        {
            _VoxelBuffer[voxelIdx].density += sediment * 5.0; // 퇴적(밀도 증가)
            break;
        }

        // 입자 이동
        dir = flowDir;
        pos += dir * 0.7;

        // --- 침식 및 퇴적 임계점 연산 ---
        float capacity = max(speed * water * (1.0 - slope) * capacityFactor, minCapacity);

        if (sediment > capacity)
        {
            // 퇴적 (Deposition): 물방울이 느려져 흙을 떨어뜨림
            float amount = (sediment - capacity) * depositionRate;
            sediment -= amount;
            // 깎인 틈을 메워 평평한 바닥(흙길)을 조성
            _VoxelBuffer[voxelIdx].density += amount * 5.0;
        }
        else
        {
            // 침식 (Erosion): 물방울이 빨라져 암석을 깎아냄
            float amount = (capacity - sediment) * erosionRate;
            // 이미 텅 빈 공간을 과도하게 파내지 않도록 방어
            amount = min(amount, max(0.0, currentDensity));
            sediment += amount;
            _VoxelBuffer[voxelIdx].density -= amount * 5.0;

            // [열 퇴화 (Thermal Weathering)]
            // 경사가 너무 가파른 절벽(slope < 0.4)인 경우 돌무더기가 붕괴되어 아래로 떨어짐
            if (slope < 0.4 && ipos.y > 0)
            {
                int belowIdx = GetVoxelIndex(ipos.x, ipos.y - 1, ipos.z);
                float slump = amount * 0.5;
                _VoxelBuffer[voxelIdx].density -= slump * 2.0; // 위쪽 깎임
                _VoxelBuffer[belowIdx].density += slump * 2.0; // 아래쪽 쌓임
            }
        }

        // 증발 및 가속도
        speed = sqrt(max(0.1, speed * speed + dir.y * dt));
        water *= (1.0 - evapRate);

        if (water < 0.01)
            break; // 물이 다 마르면 소멸
    }
}