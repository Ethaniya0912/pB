// ===============================================================================
// 파일: CaveDensityGenerator.compute
// 역할: [Phase 4 & 리팩토링 1순위] 그래프 설계도 기반 3D SDF 밀도 생성 
// 고도화: 협곡 변형(Canyon Morphing) 및 경사도 기반(Floor Protection) 마스킹 추가
// 최적화: 협곡 천장의 무한 팽창 방지 (Ceiling Limit 적용)
// ===============================================================================
#pragma kernel GenerateDensity
#pragma kernel SimulateErosion

// [모듈화 1] 공용 데이터 구조체 포함
#include "CaveDataStructs.hlsl"

// [모듈화 2] 순수 수학 함수 (hash, snoise, fBm, Voronoi2D 등) 외부 라이브러리 참조
#include "CaveNoiseLibrary.hlsl"

// [모듈화 3] 지질학적 응용 함수 (smin, smax, sdCapsule, ApplyBiomeDetail 등) 외부 참조
#include "CaveBiomeMath.hlsl"

// --- [전역 버퍼 및 상수] ---
RWStructuredBuffer<CaveVoxel> _VoxelBuffer;

StructuredBuffer<NodeData> _NodeBuffer;
int _NodeCount;
StructuredBuffer<EdgeData> _EdgeBuffer;
int _EdgeCount;

StructuredBuffer<BiomeParamData> _BiomeBuffer;
int _BiomeCount;
float _MacroBiomeScale;

float3 _ChunkBasePosition;
int _ChunkSize;
int _PointsPerAxis;
float _VoxelSize;

float _FloorAltitude;
float _CeilAltitude;
float _FloorBlendRadius;
float _WarpAmplitude;  // CaveComputeDispatcher.cs에서 SetFloat로 제어 (권장: 0.5)
float _CeilBlendRadius;

float _FloorBumpFrequency;
float _FloorBumpAmplitude;

float _SinkholeProb;
float _SinkholeMinRadius;
float _SinkholeMaxRadius;
float _SinkholeSmoothness;
float _LedgeStepHeight;
float _SpiralFrequency;
float _SpiralAmplitude;

float _TimeY;
int _DebugStage;

// [AABB] Dispatcher가 계산한 적응형 마진 (OFF=10.0, ON=smin×3+warp+2)
float _AABBMargin;

// [Phase 1] SDF 기능 토글 — OFF 시 원본 동작
float _TunnelWidthScale;   // Dispatcher 폴백: 0→1.0
float _RoomSizeScale;      // 동일
float _SedimentAmplitude;  // 0=비활성
int _EnableScaling;        // 0=off: node.radius / edge.width 그대로
int _EnableWidthVariation; // 0=off: wv=1.0
int _EnableSediment;       // 0=off: dNormal 변경 없음
int _EnableFloorDetail;    // 0=off: FloorDetail 블록 건너뜀
float _FloorDetailAmplitude;
float _FloorDetailFrequency;
float _FloorDetailRadius;

// ─────────────────────────────────────────────────────────────
// [Phase 1.5 / 옵션 B Parabolic Lift] — 제거됨.
// 원인: finalDensity를 "통로로부터의 거리" 지표로 사용한 설계 오류. 
//       합성된 bulk SDF(room+tunnel+warp+noise smin/smax)를 원시 tunnel 거리로 
//       오인하여 Y 전역에서 lift가 전역적으로 발동 → 수평층 파편 유발.
// 상세: phase_15_test_analysis.html (옵션 B 설계 오류 섹션) 및
//       본 제거 보고서 phase_15_chunk_boundary_analysis.html 참조.
// 대체: 옵션 A (Floor Y-Clamp, CaveNodeGraphBuilder)가 같은 목적을 더 안전하게 달성.
// 규칙 #19 (신규): SDF 단계 개입 시 합성 상태 문서화 의무.
// ─────────────────────────────────────────────────────────────

int GetVoxelIndex(int x, int y, int z)
{
    return x + y * _PointsPerAxis + z * _PointsPerAxis * _PointsPerAxis;
}

// ===============================================================================
// [신규] 뼈대 생성 및 협곡 변형 평가 함수
// canyonWeight에 따라 둥근 터널과 열린 협곡 사이를 자연스럽게 변형(Morph)시킵니다.
// ===============================================================================
float EvaluateSkeleton(float3 p, BiomeParamData curP, float canyonWeight, out int closestRoomType)
{
    float baseSDF = 100.0;
    closestRoomType = 0;
    float minNodeDist = 100000.0;

    // [최적화 적용] 유저가 느끼기에 충분히 높은 협곡의 천장 제한 높이 설정
    // 일반적인 캐릭터 키(약 2m)를 고려했을 때, 바닥에서 15~20m 정도 솟아있으면 충분히 웅장합니다.
    // _CeilAltitude를 활용하거나 고정값을 사용할 수 있습니다. 여기서는 노드의 중심을 기준으로 상한선을 둡니다.
    float maxCanyonHeight = 25.0;

    for (int i = 0; i < _NodeCount; i++)
    {
        NodeData node = _NodeBuffer[i];
        
        float3 distToCenter = abs(p - node.position);
        // AABB: 항상 node.radius 기준 (Scaling이 AABB를 변경하지 않음)
        if (max(distToCenter.x, max(distToCenter.y, distToCenter.z)) > node.radius + curP.sminStrength + _AABBMargin)
            continue;

        // [Phase 1: Scaling] OFF→node.radius, ON→node.radius×scale
        float nodeR = (_EnableScaling == 1) ? node.radius * _RoomSizeScale : node.radius;
        if (nodeR < 0.1) continue;

        float dNormal = length(p - node.position) - nodeR;
        
        // --- 협곡 노드 변형 (최적화 포함) ---
        float3 canyonPt = node.position;
        if (p.y > node.position.y)
        {
            // 무한히 올라가는 대신 maxCanyonHeight에서 상승을 멈춤(Ceiling 닫힘)
            canyonPt.y = min(p.y, node.position.y + maxCanyonHeight);
        }
        float dCanyon = length(p - canyonPt) - nodeR;
        float flatBottom = (node.position.y - nodeR * 0.7) - p.y;
        dCanyon = smax(dCanyon, flatBottom, 4.0);  // [바닥자연화] k=1.5→4.0: 4m 블렌딩으로 단차 완화
        // -----------------------------------

        float d = lerp(dNormal, dCanyon, canyonWeight);
        baseSDF = smin(baseSDF, d, curP.sminStrength);
        
        if (d < minNodeDist)
        {
            minNodeDist = d;
            closestRoomType = node.roomType;
        }
    }

    for (int j = 0; j < _EdgeCount; j++)
    {
        EdgeData edge = _EdgeBuffer[j];
        
        float3 mid = (edge.startPos + edge.endPos) * 0.5;
        float3 distToMid = abs(p - mid);
        float halfLen = length(edge.endPos - edge.startPos) * 0.5;
        // AABB: 항상 edge.width 기준 (Scaling이 AABB를 변경하지 않음)
        if (max(distToMid.x, max(distToMid.y, distToMid.z)) > (halfLen + edge.width + curP.sminStrength + _AABBMargin))
            continue;

        // [Phase 1: Scaling + WidthVariation] OFF→edge.width, ON→scaled
        float edgeW = (_EnableScaling == 1) ? edge.width * _TunnelWidthScale : edge.width;
        float wv = (_EnableWidthVariation == 1)
            ? lerp(0.80, 1.00, hash2D(float2(float(j) * 0.137, float(j) * 0.231)).x)
            : 1.0;
        float effectiveWidth = edgeW * wv;

        float dNormal = sdCapsule(p, edge.startPos, edge.endPos, effectiveWidth);
        
        // --- 협곡 통로 변형 (최적화 포함) ---
        float3 pa = p - edge.startPos, ba = edge.endPos - edge.startPos;
        float h = saturate(dot(pa, ba) / max(dot(ba, ba), 0.000001));
        float3 closestPt = edge.startPos + ba * h;

        // [Phase 1: Sediment] OFF→dNormal 변경 없음
        if (_EnableSediment == 1 && _SedimentAmplitude > 0.001)
        {
            float3 pa_local = p - closestPt;
            float lateralDist = length(float2(pa_local.x, pa_local.z));
            float t_sed = saturate(lateralDist / max(effectiveWidth, 0.1));
            float belowCenter = saturate((closestPt.y - p.y) / max(effectiveWidth * 0.5, 0.1));
            float safeAmp = min(_SedimentAmplitude, effectiveWidth * 0.15);
            float sedMask = saturate((effectiveWidth - length(pa_local)) / max(effectiveWidth * 0.3, 0.1));
            dNormal += t_sed * t_sed * belowCenter * safeAmp * sedMask;
        }

        float3 canyonEdgePt = closestPt;
        if (p.y > closestPt.y)
        {
            // 통로 역시 무한 확장을 막고 일정 높이에서 천장을 덮습니다.
            canyonEdgePt.y = min(p.y, closestPt.y + maxCanyonHeight);
        }
        float dCanyonEdge = length(p - canyonEdgePt) - effectiveWidth;
        float flatBottomEdge = (closestPt.y - effectiveWidth * 0.7) - p.y;
        dCanyonEdge = smax(dCanyonEdge, flatBottomEdge, 4.0);  // [바닥자연화] k=1.5→4.0
        // -----------------------------------
        
        float d = lerp(dNormal, dCanyonEdge, canyonWeight);
        baseSDF = smin(baseSDF, d, curP.sminStrength);
    }
    
    return baseSDF;
}

// ===============================================================================
// 커널 1: 지형 생성 및 이중 SDF 블렌딩 (GenerateDensity)
// ===============================================================================
[numthreads(8, 8, 8)]
void GenerateDensity(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint) _PointsPerAxis || id.y >= (uint) _PointsPerAxis || id.z >= (uint) _PointsPerAxis)
        return;
    
    int index = GetVoxelIndex(id.x, id.y, id.z);
    float3 worldPos = _ChunkBasePosition + (id * _VoxelSize);
    
    if (_NodeCount == 0 || _BiomeCount == 0)
    {
        _VoxelBuffer[index].density = 100.0;
        _VoxelBuffer[index].oreType = 0;
        return;
    }

    // 1. 마크로 바이옴 맵 스플래팅
    float macroNoise = snoise2D(worldPos.xz / max(_MacroBiomeScale, 1.0));
    float normalizedNoise = macroNoise * 0.5 + 0.5;
    
    float scaledMap = normalizedNoise * max((float) (_BiomeCount - 1), 0.0);
    int bIdxA = clamp((int) floor(scaledMap), 0, _BiomeCount - 1);
    int bIdxB = clamp(bIdxA + 1, 0, _BiomeCount - 1);
    float blendWeight = smoothstep(0.0, 1.0, frac(scaledMap));

    BiomeParamData pA = _BiomeBuffer[bIdxA];
    BiomeParamData pB = _BiomeBuffer[bIdxB];

    // 2. 파라미터 보간
    BiomeParamData curP;
    curP.noiseFrequency = lerp(pA.noiseFrequency, pB.noiseFrequency, blendWeight);
    curP.yCompression = lerp(pA.yCompression, pB.yCompression, blendWeight);
    curP.sminStrength = lerp(pA.sminStrength, pB.sminStrength, blendWeight);
    curP.terraceSteps = lerp(pA.terraceSteps, pB.terraceSteps, blendWeight);
    curP.bumpAmplitude = lerp(pA.bumpAmplitude, pB.bumpAmplitude, blendWeight);
    curP.bumpFrequency = lerp(pA.bumpFrequency, pB.bumpFrequency, blendWeight);
    
    int typeA = pA.noiseType;
    int typeB = pB.noiseType;

    // [핵심] 현재 위치가 Case 5(협곡 스타일)일 확률 계산
    float canyonWeight = 0.0;
    if (typeA == 5)
        canyonWeight += (1.0 - blendWeight);
    if (typeB == 5)
        canyonWeight += blendWeight;

    // 3. 뼈대 생성 (협곡 변형 적용)
    int closestRoomType = 0;
    // [바닥자연화] Domain Warp — EvaluateSkeleton 좌표를 노이즈로 왜곡
    //   XZ만 warp (Y=0): 높이는 유지하며 평면 형태만 비정형화
    //   amplitude 0.8~1.2: 통로 반경(3~5m) 대비 최대 20~25% 변형 → 통과성 보장
    // [Inspector] _WarpAmplitude는 CaveComputeDispatcher.SetFloat로 외부 설정
    float warpX = snoise2D((worldPos.xz + float2(1.7, 9.2)) * 0.11) * _WarpAmplitude;
    float warpZ = snoise2D((worldPos.xz + float2(8.3, 2.8)) * 0.11) * _WarpAmplitude;
    // Y warp 제외: 바닥 높이 안정성 유지 (Domain Warp가 바닥면을 왜곡하지 않음)
    float3 warpedPos = worldPos + float3(warpX, 0.0, warpZ);
    float baseSDF = EvaluateSkeleton(warpedPos, curP, canyonWeight, closestRoomType);

    if (_DebugStage == 0)
    {
        if (isnan(baseSDF) || isinf(baseSDF))
            baseSDF = 100.0;
        _VoxelBuffer[index].density = baseSDF;
        _VoxelBuffer[index].oreType = 0;
        return;
    }

    // 3.5. 바닥 보호를 위한 기울기(Normal Y) 추정
    // Y축 위/아래로 살짝 샘플링하여 지형이 평지인지 수직 절벽인지 파악합니다.
    int tempRoom;
    float baseUp = EvaluateSkeleton(worldPos + float3(0, 1.0, 0), curP, canyonWeight, tempRoom);
    float baseDn = EvaluateSkeleton(worldPos - float3(0, 1.0, 0), curP, canyonWeight, tempRoom);
    float normalY = (baseUp - baseDn) * 0.5;

    // 4. 이중 SDF 블렌딩 (바닥 보호 마스킹 전달)
    float densityA = ApplyBiomeDetail(typeA, worldPos, baseSDF, normalY, curP);
    float densityB = ApplyBiomeDetail(typeB, worldPos, baseSDF, normalY, curP);
    float finalDensity = lerp(densityA, densityB, blendWeight);

    if (_DebugStage == 1)
    {
        if (isnan(finalDensity) || isinf(finalDensity))
            finalDensity = 100.0;
        _VoxelBuffer[index].density = finalDensity;
        _VoxelBuffer[index].oreType = (closestRoomType << 16);
        return;
    }

    // 5. 플레이어블 바닥(Global Floor) 캡핑
    float floorBump = snoise2D(worldPos.xz * max(curP.bumpFrequency, 0.001)) * curP.bumpAmplitude;
    float floorPlaneSDF = (_FloorAltitude + floorBump) - worldPos.y;
    float ceilPlaneSDF = worldPos.y - _CeilAltitude;
    
    finalDensity = smax(finalDensity, floorPlaneSDF, max(_FloorBlendRadius, 0.1));
    finalDensity = smax(finalDensity, ceilPlaneSDF, max(_CeilBlendRadius, 0.1));

    // [Phase 1.5: FloorDetail] OFF → 건너뜀 (원본에 없는 기능)
    // normalY로 벽면 방지: normalY>0.7(수평바닥)=풀 적용, normalY<0.3(수직벽)=0
    if (_EnableFloorDetail == 1 && _FloorDetailAmplitude > 0.001)
    {
        float rawDist = worldPos.y - _FloorAltitude;
        float floorMask = (rawDist >= 0.0)
            ? saturate(1.0 - rawDist / max(_FloorDetailRadius, 0.1))
            : 0.0;
        float wallReject = smoothstep(0.3, 0.7, normalY);
        float floorDetail = snoise2D(worldPos.xz * max(_FloorDetailFrequency, 0.001))
                            * _FloorDetailAmplitude;
        finalDensity += floorDetail * floorMask * wallReject;
    }

    // [바닥자연화] 고주파 침식 노이즈
    float erosionMask = saturate(1.0 - abs(finalDensity) * 0.5);
    float erosionNoise = snoise2D(worldPos.xz * 0.6 + float2(3.1, 7.4)) * 0.35
                       + snoise2D(worldPos.xz * 1.3 + float2(5.5, 2.2)) * 0.12;
    finalDensity += erosionNoise * erosionMask * 0.7;

    if (_SinkholeProb > 0.01 && hash2D(_ChunkBasePosition.xz).x < _SinkholeProb)
    {
        float sinkholeRadius = lerp(_SinkholeMinRadius, _SinkholeMaxRadius, hash2D(_ChunkBasePosition.zx).y);
        float distToSinkhole = length(worldPos.xz - _ChunkBasePosition.xz);
        float sinkholeSDF = distToSinkhole - sinkholeRadius;
        
        float sinkholeMask = 1.0 - smoothstep(sinkholeRadius - 2.0, sinkholeRadius + 4.0, distToSinkhole);
        float terrace = (floor(worldPos.y / max(_LedgeStepHeight, 1.0)) * _LedgeStepHeight) - worldPos.y;
        float angle = atan2(worldPos.z - _ChunkBasePosition.z, worldPos.x - _ChunkBasePosition.x);
        float spiral = sin(worldPos.y * max(_SpiralFrequency, 0.01) + angle * 3.0) * _SpiralAmplitude;
        
        finalDensity = smax(finalDensity, -sinkholeSDF, max(_SinkholeSmoothness, 0.1));
        finalDensity += (terrace + spiral) * sinkholeMask;

        if (distToSinkhole < sinkholeRadius)
            closestRoomType = 4;
    }

    if (isnan(finalDensity) || isinf(finalDensity))
        finalDensity = 100.0;
    _VoxelBuffer[index].density = finalDensity;

    int isOre = (finalDensity < 0.0 && hash2D(worldPos.xz * 10.0).x > 0.98) ? 1 : 0;
    _VoxelBuffer[index].oreType = (closestRoomType << 16) | isOre;
}

// ===============================================================================
// 커널 2: 물리 시뮬레이션 (SimulateErosion)
// ===============================================================================
[numthreads(64, 1, 1)]
void SimulateErosion(uint3 id : SV_DispatchThreadID)
{
    float2 seed = float2((float) id.x, _TimeY);
    float3 pos = float3(hash2D(seed).x * (float) _ChunkSize, (float) _ChunkSize - 1.0, hash2D(seed.yx).y * (float) _ChunkSize);
    
    float inertia = 0.1;
    float sedimentCapacityFactor = 4.0;
    float minSedimentCapacity = 0.01;
    float erodeSpeed = 0.3;
    float depositSpeed = 0.3;
    float evaporateSpeed = 0.01;
    float gravity = 4.0;

    float3 dir = float3(0, 0, 0);
    float sediment = 0;
    float speed = 1.0;
    float water = 1.0;

    for (int step = 0; step < 30; step++)
    {
        uint3 ipos = uint3(pos);
        if (ipos.x >= (uint) _PointsPerAxis - 1 || ipos.y >= (uint) _PointsPerAxis - 1 || ipos.z >= (uint) _PointsPerAxis - 1 || any(ipos < 1))
            break;

        int idxXp = GetVoxelIndex(ipos.x + 1, ipos.y, ipos.z);
        int idxXn = GetVoxelIndex(ipos.x - 1, ipos.y, ipos.z);
        int idxYp = GetVoxelIndex(ipos.x, ipos.y + 1, ipos.z);
        int idxYn = GetVoxelIndex(ipos.x, ipos.y - 1, ipos.z);
        int idxZp = GetVoxelIndex(ipos.x, ipos.y, ipos.z + 1);
        int idxZn = GetVoxelIndex(ipos.x, ipos.y, ipos.z - 1);

        float gradX = _VoxelBuffer[idxXp].density - _VoxelBuffer[idxXn].density;
        float gradY = _VoxelBuffer[idxYp].density - _VoxelBuffer[idxYn].density;
        float gradZ = _VoxelBuffer[idxZp].density - _VoxelBuffer[idxZn].density;
        float3 grad = float3(gradX, gradY, gradZ);

        dir = (dir * inertia) - (grad * (1.0 - inertia));
        
        float lenDir = length(dir);
        if (lenDir > 0.0001)
            dir /= lenDir;
        
        dir = normalize(dir + float3(0, -0.05, 0));

        float3 nextPos = pos + dir;
        if (any(nextPos < 0.5) || any(nextPos >= (float) _ChunkSize - 0.5))
            break;

        float densityDiff = gradY;
        float sedimentCapacity = max(-densityDiff * speed * water * sedimentCapacityFactor, minSedimentCapacity);

        int curIdx = GetVoxelIndex(ipos.x, ipos.y, ipos.z);

        if (sediment > sedimentCapacity || densityDiff > 0)
        {
            float depositAmount = (sediment - sedimentCapacity) * depositSpeed;
            _VoxelBuffer[curIdx].density += depositAmount;
            sediment -= depositAmount;
        }
        else
        {
            float erodeAmount = min((sedimentCapacity - sediment) * erodeSpeed, -densityDiff);
            _VoxelBuffer[curIdx].density -= erodeAmount;
            sediment += erodeAmount;
        }

        speed = sqrt(max(0.0, speed * speed + densityDiff * gravity));
        water *= (1.0 - evaporateSpeed);
        pos = nextPos;
        
        if (water < 0.05)
            break;
    }
}