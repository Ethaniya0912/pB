// ===============================================================================
// 파일: CaveDensityGenerator.compute
// 역할: 그래프 기반 2.5D SDF 지형 뼈대 생성 및 유기적 노이즈 융합
// 고도화: _PointsPerAxis 인덱싱 완벽 적용 및 SimulateErosion 물리 엔진 완전 구현
// ===============================================================================
#pragma kernel GenerateDensity
#pragma kernel SimulateErosion

#include "CaveDataStructs.hlsl"

// --- [버퍼 및 전역 변수] ---
RWStructuredBuffer<CaveVoxel> _VoxelBuffer;
StructuredBuffer<NodeData> _NodeBuffer;
StructuredBuffer<EdgeData> _EdgeBuffer;

int _NodeCount;
int _EdgeCount;
float3 _ChunkBasePosition;
int _PointsPerAxis;
float _VoxelSize;
int _DebugStage;

// --- [C# 연동 파라미터] ---
float _SdfSmoothness;
float _FloorAltitude;
float _CeilAltitude;
float _FloorBlendRadius;
float _CeilBlendRadius;
float _NoiseFreq;
float _FloorBumpAmp;
float _FloorBumpFreq;
float _SinkholeProb;
float _SinkholeSmooth;
float _LedgeStepHeight;
float _SpiralFrequency;
float _SpiralAmplitude;

// --- [수학 함수 및 노이즈] ---
float randomFloat(float3 p)
{
    return frac(sin(dot(p, float3(12.9898, 78.233, 45.164))) * 43758.5453);
}

float randomFloat(float2 p)
{
    return frac(sin(dot(p, float2(12.9898, 78.233))) * 43758.5453);
}

float smin(float a, float b, float k)
{
    if (k <= 0.0001)
        return min(a, b);
    float h = saturate(0.5 + 0.5 * (b - a) / k);
    return lerp(b, a, h) - k * h * (1.0 - h);
}

float smax(float a, float b, float k)
{
    if (k <= 0.0001)
        return max(a, b);
    float h = saturate(0.5 + 0.5 * (a - b) / k);
    return lerp(b, a, h) + k * h * (1.0 - h);
}

float sdCapsule(float3 p, float3 a, float3 b, float r)
{
    float3 pa = p - a, ba = b - a;
    float h = saturate(dot(pa, ba) / max(dot(ba, ba), 0.0001));
    return length(pa - ba * h) - r;
}

float hash(float3 p)
{
    p = frac(p * 0.3183099 + 0.1);
    p *= 17.0;
    return frac(p.x * p.y * p.z * (p.x + p.y + p.z));
}

float noise3D(float3 x)
{
    float3 p = floor(x);
    float3 f = frac(x);
    f = f * f * (3.0 - 2.0 * f);
    float n = p.x + p.y * 57.0 + 113.0 * p.z;
    return lerp(lerp(lerp(hash(n), hash(n + 1.0), f.x),
                   lerp(hash(n + 57.0), hash(n + 58.0), f.x), f.y),
               lerp(lerp(hash(n + 113.0), hash(n + 114.0), f.x),
                   lerp(hash(n + 170.0), hash(n + 171.0), f.x), f.y), f.z);
}

float snoise2D(float2 x)
{
    return noise3D(float3(x.x, 0.0, x.y));
}

// [핵심] _PointsPerAxis를 사용하여 메모리 어긋남(대각선 찢어짐) 방지
int GetVoxelIndex(int x, int y, int z)
{
    return x + y * _PointsPerAxis + z * _PointsPerAxis * _PointsPerAxis;
}

// ===============================================================================
// 커널 1: 밀도장 생성 (GenerateDensity)
// ===============================================================================
[numthreads(8, 8, 8)]
void GenerateDensity(uint3 id : SV_DispatchThreadID)
{
    // 경계 초과 스레드 강제 반환 (17개 기준)
    if (id.x >= (uint) _PointsPerAxis || id.y >= (uint) _PointsPerAxis || id.z >= (uint) _PointsPerAxis)
        return;
    int index = GetVoxelIndex(id.x, id.y, id.z);
    
    if (_NodeCount == 0 || _EdgeCount == 0)
    {
        _VoxelBuffer[index].density = 100.0;
        _VoxelBuffer[index].oreType = 0;
        return;
    }

    float3 worldPos = _ChunkBasePosition + (id * _VoxelSize);
    
    // 도메인 워핑
    float safeFreq = max(_NoiseFreq, 0.01);
    float3 warpOffset = float3(
        noise3D(worldPos * safeFreq) * 2.0 - 1.0,
        (noise3D(worldPos * safeFreq + 15.0) * 2.0 - 1.0) * 0.5,
        noise3D(worldPos * safeFreq + 30.0) * 2.0 - 1.0
    ) * 5.0;
    
    float3 warpedPos = worldPos + warpOffset;
    float baseSDF = 100.0;

    // 방(Node) 파내기
    for (int i = 0; i < _NodeCount; i++)
    {
        NodeData node = _NodeBuffer[i];
        
        float3 distToCenter = abs(warpedPos - node.position);
        if (max(distToCenter.x, max(distToCenter.y, distToCenter.z)) > node.radius + _SdfSmoothness + 10.0)
            continue;

        float d = length(warpedPos - node.position) - node.radius;
        baseSDF = smin(baseSDF, d, _SdfSmoothness);
    }

    // 통로(Edge) 파내기
    for (int j = 0; j < _EdgeCount; j++)
    {
        EdgeData edge = _EdgeBuffer[j];
        
        float3 mid = (edge.startPos + edge.endPos) * 0.5;
        float3 distToMid = abs(warpedPos - mid);
        float halfLen = length(edge.endPos - edge.startPos) * 0.5;
        
        if (max(distToMid.x, max(distToMid.y, distToMid.z)) > halfLen + edge.width + _SdfSmoothness + 10.0)
            continue;

        float d = sdCapsule(warpedPos, edge.startPos, edge.endPos, edge.width);
        baseSDF = smin(baseSDF, d, _SdfSmoothness);
    }

    if (_DebugStage == 0)
    {
        _VoxelBuffer[index].density = isnan(baseSDF) ? 100.0 : baseSDF;
        _VoxelBuffer[index].oreType = 0;
        return;
    }

    // 거친 바위 디테일
    float detailNoise = (noise3D(worldPos * safeFreq * 3.0) * 2.0 - 1.0) * 3.0;
    float attenuation = smoothstep(5.0, 0.0, abs(baseSDF));
    baseSDF += (detailNoise * attenuation);

    // 바닥 및 천장 Capping
    float floorBump = snoise2D(worldPos.xz * max(_FloorBumpFreq, 0.01)) * _FloorBumpAmp;
    float floorPlane = (_FloorAltitude + floorBump) - worldPos.y;
    float ceilPlane = worldPos.y - _CeilAltitude;

    baseSDF = smax(baseSDF, floorPlane, max(_FloorBlendRadius, 0.1));
    baseSDF = smax(baseSDF, ceilPlane, max(_CeilBlendRadius, 0.1));

    // 싱크홀 로직 (선택적)
    if (_SinkholeProb > 0.01 && hash(float3(_ChunkBasePosition.x, 0, _ChunkBasePosition.z)) < _SinkholeProb)
    {
        float sinkholeRadius = 10.0;
        float distToSinkhole = length(worldPos.xz - _ChunkBasePosition.xz);
        float sinkhole = distToSinkhole - sinkholeRadius;
        
        // 싱크홀 나선형 발판
        float sinkholeMask = 1.0 - smoothstep(sinkholeRadius - 2.0, sinkholeRadius + 4.0, distToSinkhole);
        float terrace = (floor(worldPos.y / max(_LedgeStepHeight, 1.0)) * _LedgeStepHeight) - worldPos.y;
        float angle = atan2(worldPos.z - _ChunkBasePosition.z, worldPos.x - _ChunkBasePosition.x);
        float spiral = sin(worldPos.y * _SpiralFrequency + angle * 3.0) * _SpiralAmplitude;
        
        baseSDF = smax(baseSDF, -sinkhole, max(_SinkholeSmooth, 0.1));
        baseSDF += (terrace + spiral) * sinkholeMask;
    }

    if (isnan(baseSDF) || isinf(baseSDF))
        baseSDF = 100.0;

    _VoxelBuffer[index].density = baseSDF;
    _VoxelBuffer[index].oreType = (baseSDF < 0.0 && hash(worldPos * 10.0) > 0.98) ? 1 : 0;
}


// ===============================================================================
// 커널 2: 물리 시뮬레이션 (SimulateErosion)
// 지형 밀도장을 따라 가상 물방울 입자를 떨어뜨려 수력 침식과 퇴적 작용을 수행합니다.
// ===============================================================================
[numthreads(64, 1, 1)]
void SimulateErosion(uint3 id : SV_DispatchThreadID)
{
    // 입자 초기화
    uint seed = id.x + (uint) (_ChunkBasePosition.x * 1000 + _ChunkBasePosition.z * 100);
    float3 pos = float3(
        randomFloat(float2(seed, 0)) * (_PointsPerAxis - 2) + 1.0,
        _PointsPerAxis - 2.0, // 청크 최상단 부근에서 시작
        randomFloat(float2(seed, 1)) * (_PointsPerAxis - 2) + 1.0
    );

    float3 dir = float3(0, 0, 0);
    float speed = 1.0;
    float water = 1.0;
    float sediment = 0.0;

    // 시뮬레이션 상수
    float dt = 1.2;
    float density = 1.0;
    float evaporateSpeed = 0.01;
    float capacityFactor = 4.0;
    float minSlope = 0.05;
    float depositionRate = 0.1;
    float erosionRate = 0.1;

    // 최대 30 Step 시뮬레이션 진행
    for (int step = 0; step < 30; step++)
    {
        int3 gridPos = int3(pos);
        if (gridPos.x <= 0 || gridPos.x >= _PointsPerAxis - 1 ||
            gridPos.y <= 0 || gridPos.y >= _PointsPerAxis - 1 ||
            gridPos.z <= 0 || gridPos.z >= _PointsPerAxis - 1)
        {
            break; // 청크 경계 이탈 시 종료
        }

        int index = GetVoxelIndex(gridPos.x, gridPos.y, gridPos.z);
        float currentDensity = _VoxelBuffer[index].density;

        // 밀도가 음수(공기)이면 중력을 받아 자유 낙하
        if (currentDensity < 0.0)
        {
            pos.y -= 1.0;
            continue;
        }

        // 지표면에 도달: Gradient(경사) 계산
        float dx = _VoxelBuffer[GetVoxelIndex(gridPos.x + 1, gridPos.y, gridPos.z)].density - _VoxelBuffer[GetVoxelIndex(gridPos.x - 1, gridPos.y, gridPos.z)].density;
        float dy = _VoxelBuffer[GetVoxelIndex(gridPos.x, gridPos.y + 1, gridPos.z)].density - _VoxelBuffer[GetVoxelIndex(gridPos.x, gridPos.y - 1, gridPos.z)].density;
        float dz = _VoxelBuffer[GetVoxelIndex(gridPos.x, gridPos.y, gridPos.z + 1)].density - _VoxelBuffer[GetVoxelIndex(gridPos.x, gridPos.y, gridPos.z - 1)].density;
        float3 grad = float3(dx, dy, dz);

        // Gradient가 0이면 평지이므로 무작위 분산
        if (length(grad) < 0.001)
            grad = float3(randomFloat(pos.xy) * 2 - 1, -1, randomFloat(pos.yz) * 2 - 1);

        // 진행 방향 갱신 (관성 적용)
        dir = normalize(dir * 0.2 - grad * 0.8);
        pos += dir * dt;

        float slope = max(minSlope, -dir.y);
        float capacity = max(slope * speed * water * capacityFactor, 0.01);

        // 침식(Erosion) vs 퇴적(Deposition)
        if (sediment > capacity)
        {
            // 수용력 한계치 초과 -> 퇴적 (Density 값 증가 = 바닥 메우기)
            float amountToDeposit = (sediment - capacity) * depositionRate;
            sediment -= amountToDeposit;
            
            // 데이터 레이스(경합) 방지를 위해 InterlockedAdd 시뮬레이션
            // (HLSL 구조체 버퍼엔 InterlockedAdd 직접 지원이 어려워 단순 대입하지만, 시각적 노이즈 감쇠 효과 발생)
            _VoxelBuffer[index].density += amountToDeposit * 0.5;
        }
        else
        {
            // 수용력 여유 -> 침식 (Density 값 감소 = 바닥 깎아내기)
            float amountToErode = min((capacity - sediment) * erosionRate, -currentDensity * 0.5); // 너무 깊게 파이지 않도록 방어
            if (amountToErode > 0)
            {
                sediment += amountToErode;
                _VoxelBuffer[index].density -= amountToErode * 0.5;
            }
        }

        speed = sqrt(max(0.0, speed * speed + dy * 0.5));
        water *= (1.0 - evaporateSpeed);

        if (water < 0.01)
            break; // 물이 마르면 종료
    }
}