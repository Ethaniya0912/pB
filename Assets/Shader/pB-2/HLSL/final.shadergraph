{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "63075b80cb41449d8316c2d44d952674",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "ApplyVertexSnapping (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -880.9999389648438,
            "y": 2.9999969005584719,
            "width": 277.0,
            "height": 398.0
        }
    },
    "m_Slots": [
        {
            "m_Id": "b7ca2f47c1da4c9a8f87045cc70e46cf"
        },
        {
            "m_Id": "bf3b836a7d5f4bcfa30383bbec1af39f"
        },
        {
            "m_Id": "8f31c185ff614ca9a63648071c9b9aba"
        },
        {
            "m_Id": "17c568e029be4683a01337ab4e880e0b"
        },
        {
            "m_Id": "647f041e6b064acfb285ab9d0d772d8b"
        },
        {
            "m_Id": "bab7b98ea64e4d5cabf5a1127d43d1ff"
        },
        {
            "m_Id": "26464cad500443a7baeeb8be61c326d6"
        }
    ],
    "synonyms": [
        "code",
        "HLSL",
        "Jitter"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": true,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 0,
    "m_FunctionName": "ApplyVertexSnapping",
    "m_FunctionSource": "366ea3f4e37618d4bb1eb36203dfe13e",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "// Spec v5.0 일치화 로직\r\nfloat4 posCS = TransformObjectToHClip(posOS);\r\nfloat dist = posCS.w;\r\n\r\n// 1. 근거리 보호 (Near Clip Guard)\r\nfloat guardFactor = smoothstep(0.0, _NearClipGuard, dist);\r\n\r\n// 2. 시간 기반 애니메이션 (Animation Speed)\r\nfloat timeOffset = _AnimationSpeed > 0 ? sin(_Time.y * _AnimationSpeed * 5.0) * 0.05 : 0;\r\n\r\n// 3. 최종 강도 결합 (Intensity + Distance Attenuation)\r\nfloat finalIntensity = (_JitterIntensity + timeOffset) * (1.0 + dist * _DistAttenuation) * guardFactor;\r\n\r\nif (finalIntensity > 0.001) \r\n{\r\n    // 4. 해상도 그리드 스냅 (Resolution Scale)\r\n    float2 snapGrid = _ResolutionScale.xy / max(0.01, finalIntensity);\r\n    posCS.xy = floor(posCS.xy * snapGrid) / snapGrid;\r\n}\r\n\r\n// 5. 복원 및 출력\r\nfloat4 worldPos = mul(UNITY_MATRIX_I_VP, posCS);\r\nworldPos /= worldPos.w;\r\noutPos = mul(UNITY_MATRIX_I_M, worldPos).xyz;"
}

