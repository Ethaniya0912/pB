    "m_SourceType": 1,
    "m_FunctionName": "apply_scanline",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "float scanline = sin(UV.y * Density + Time * Speed);\nfloat factor = lerp(1.0, saturate(scanline * 0.5 + 0.5), Intensity);\nOut = Color * factor;"
}

